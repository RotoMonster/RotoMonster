@page
@using RotoMonster.Models.Shared;
@model RotoMonster.Pages.DepthChartsModel
@{
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
}

<div class="container-fluid px-4">

@Html.Raw(new PageGuide("depth-guide")
    .WithTitle("Depth Charts")
    .WithPurpose("Depth charts show how each team lines up by position, so you can see who is ahead of who and spot players in line for more playing time.")
    .AddSection("Reading a card", "<p>Each card is one team. Rows are ordered by position and then by depth, so the player listed first at a position is the starter and the ones below are the backups.</p><p>The number beside the position is that player's depth, and the percentage is how widely they are rostered across leagues.</p>")
    .AddSection("Why depth matters", "<p>A backup with a low ownership percent sitting behind an injured starter is the classic pickup. The depth chart is where you see that before it shows up in the rankings.</p><p>Players marked injured stay listed at their position so you can see who is likely to fill in for them.</p>")
    .AddSection("The monster bar", "<p>The bar on each row summarises how the player has performed over several windows at once, so you can see recent form and season-long production side by side without opening the rankings.</p><p>Use the checkboxes above to show the per game bar, the total bar, or both.</p>")
    .AddSection("Filtering", "<p>The team dropdown narrows to a single team. <strong>Hide 0% Players</strong> removes players nobody rosters, which cuts the cards down to the names actually worth watching.</p>")
    .WithTourId("depth-tour")
    .Render())

@Html.Raw(new Tour("depth-tour")
    .WithManualTrigger()
    .AddStep("SelectedTeamId", "Pick a single team here, or leave it on All to see every team's chart at once.", TooltipPosition.Bottom)
    .AddStep("HideZeroPlayers", "Hide 0% Players drops everyone nobody rosters, so you are left with the players actually worth tracking.", TooltipPosition.Bottom)
    .AddStep("ShowGameMonsterBar", "This toggles the per game monster bar on each row, which shows recent form at a glance.", TooltipPosition.Bottom)
    .AddStep("rm-tour-depth-refresh", "Refresh pulls the latest depth and ownership data.", TooltipPosition.Bottom)
    .Render())

    @* _PageTitleRow removed: its title moved to the header block, its league
       dropdown moved to _Layout and its search is off, so it rendered as an
       empty styled band. *@
    <form method="post" asp-page-handler="Refresh">


        <div class="row m-1 mb-1">
            <div class="col-auto p-1">
                <select asp-for="@Model.SelectedTeamId" class="form-control" asp-items="ViewBag.TeamList" onchange="this.form.submit()"></select>
            </div>
            <div class="col-auto p-1">
                <button id="rm-tour-depth-refresh" class="btn btn-primary" asp-page-handler="Refresh">Refresh</button>
            </div>
        </div>

        <div class="row m-1 mb-1">
            <div class="col-auto p-1">
                <label class="form-check-label">
                    <input asp-for="HideZeroPlayers" onchange="this.form.submit()">
                    @Html.DisplayNameFor(model => model.HideZeroPlayers)
                </label>
            </div>
            <div class="col-auto p-1">
                <label class="form-check-label">
                    <input asp-for="ShowGameMonsterBar" onchange="this.form.submit()">
                    @Html.DisplayNameFor(model => model.ShowGameMonsterBar)
                </label>
            </div>
            <div class="col-auto p-1">
                <label class="form-check-label">
                    <input asp-for="ShowTotalMonsterBar" onchange="this.form.submit()">
                    @Html.DisplayNameFor(model => model.ShowTotalMonsterBar)
                </label>
            </div>
        </div>

    </form>

    @* Grid rather than floats: floats wrap raggedly when cards differ in
       height. auto-fill reflows without breakpoints. *@
    <div class="rm-depth-grid">
        @foreach (var depthChartTeamModel in Model.DepthChartTeamModels)
        {
            <div class="card p-2 rm-depth-card" style="border-color:#@ViewData["LogoColor"];">
                <div class="card-header">
                    <h2>@depthChartTeamModel.Team.Name</h2>
                </div>

                <div class="card-body">
                    <table class="table table-sm small table-bordered w-auto">

                        <thead>
                            <tr>
                                <th>Own</th>
                                <th class="tdc">Pos</th>
                                <th>Player</th>
                                <th>Own%</th>
                                @if (Model.ShowGameMonsterBar)
                                {
                                    <th class="tdc">
                                        @{ var tipIdG = ViewContext.HttpContext.NextTooltipId(); }
                                        <span class="bm-tooltip-wrap">
                                        <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipIdG">
                                            @Model.MonsterBar.ColumnTitle(false)<small class="ms-1">game</small>
                                        </span>
                                        <div class="bm-tooltip-content" id="@tipIdG" role="tooltip">@Model.MonsterBar.Tooltip</div>
                                        </span>
                                    </th>
                                }
                                @if (Model.ShowTotalMonsterBar)
                                {
                                    <th class="tdc">
                                        @{ var tipIdT = ViewContext.HttpContext.NextTooltipId(); }
                                        <span class="bm-tooltip-wrap">
                                        <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipIdT">
                                            @Model.TotalMonsterBar.ColumnTitle(false)<small class="ms-1">total</small>
                                        </span>
                                        <div class="bm-tooltip-content" id="@tipIdT" role="tooltip">@Model.TotalMonsterBar.Tooltip</div>
                                        </span>
                                    </th>
                                }
                                @if (Model.ShowPositionPercents)
                                {
                                    <th class="tdc">Position %</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var dp in depthChartTeamModel.DisplayPlayers)
                            {
                                <tr>
                                    <td class="tdc text-center text-nowrap text-white pe-1 @colorLib.GetDisplayPlayerOwnCss(dp)" style="min-width:40px;">
                                        <partial name="_DisplayPlayerOwn" model="dp" />
                                    </td>

                                    <td class="tdc text-nowrap">
                                        @if (dp.DepthPlayer != null && dp.DepthPlayer.Position != null)
                                        {
                                            <small><partial name="_ColoredPosition" model="dp.DepthPlayer.Position" /></small>
                                            @dp.DepthPlayer.Depth
                                            @if (dp.DepthPlayer.OwnershipDepthPercent > 0)
                                            {
                                                <small>@String.Format("{0:##0}",dp.DepthPlayer.OwnershipDepthPercent)</small>
                                            }
                                        }
                                        else
                                        {
                                            <small><partial name="_ColoredPosition" model="dp.SeasonPlayer.Player.DefaultPosition" /></small>
                                        }
                                        <partial name="_HigherDepthInjuredDisplayPlayers" model="dp.HigherDepthInjuredDisplayPlayers" />
                                    </td>

                                    <td class="ps-1 pe-1 text-nowrap">
                                        <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp}" />
                                    </td>

                                    @if (dp.OwnershipPlayer != null)
                                    {
                                        <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipGetPercentColor(dp.OwnershipPlayer.OwnershipPercent)">
                                            @String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)
                                            @if (dp.OwnershipPlayer.PercentOwnershipChange != 0)
                                            {
                                                <small class="text-nowrap float-start pe-1 ps-1 me-1" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.OwnershipPlayer.PercentOwnershipChange)">
                                                    <partial name="_ShowPlusIfPositive" model="dp.OwnershipPlayer.PercentOwnershipChange" />@String.Format("{0:##0}", dp.OwnershipPlayer.PercentOwnershipChange)
                                                </small>
                                            }
                                        </span></td>
                                    }
                                    else
                                    {
                                        <td />
                                    }

                                    @if (Model.ShowGameMonsterBar)
                                    {
                                        <td class="text-nowrap flex-nowrap">
                                            <partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarGamePlayer, Model.MonsterBar.MonsterBarItems)" />
                                        </td>
                                    }

                                    @if (Model.ShowTotalMonsterBar)
                                    {
                                        <td class="text-nowrap flex-nowrap">
                                            <partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarTotalPlayer, Model.TotalMonsterBar.MonsterBarItems, false, null, true)" />
                                        </td>
                                    }

                                    @if (Model.ShowPositionPercents)
                                    {
                                        <td class="text-nowrap flex-nowrap">
                                            <partial name="_PlayerPositionPercents" model="new PlayerPositionPercentsModel(){AllPositions=Model.AllPositions,PlayerPositionPercents=dp.PlayerPositionPercents}" />
                                        </td>
                                    }

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }
    </div>
</div>
