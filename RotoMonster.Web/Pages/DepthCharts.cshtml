@page
@using RotoMonster.Models.Shared;
@model RotoMonster.Pages.DepthChartsModel
@{
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
}

<div class="container-fluid px-4">

@Html.Raw(new PageGuide("depth-guide")
    .WithTitle("Depth Charts")
    .WithPurpose("Depth charts show how each team lines up by position, so you can see who is ahead of who and spot players in line for more playing time.")
    .AddSection("Reading a card", "<p>Each card is one team. Rows are ordered by position and then by depth, so the player listed first at a position is the starter and the ones below are the backups.</p><p>The number beside the position is that player's depth, and the percentage is how widely they are rostered across leagues.</p>")
    .AddSection("Why depth matters", "<p>A backup with a low ownership percent sitting behind an injured starter is the classic pickup. The depth chart is where you see that before it shows up in the rankings.</p><p>Players marked injured stay listed at their position so you can see who is likely to fill in for them.</p>")
    .AddSection("The monster bar", "<p>The bar on each row summarises how the player has performed over several windows at once, so you can see recent form and season-long production side by side without opening the rankings.</p><p>Use the checkboxes above to show the per game bar, the total bar, or both.</p>")
    .AddSection("Filtering", "<p>The team dropdown narrows to a single team. <strong>Hide 0% Players</strong> removes players nobody rosters, which cuts the cards down to the names actually worth watching.</p>")
    .WithTourId("depth-tour")
    .Render())

@Html.Raw(new Tour("depth-tour")
    .WithManualTrigger()
    .AddStep("SelectedTeamId", "Pick a single team here, or leave it on All to see every team's chart at once.", TooltipPosition.Bottom)
    .AddStep("HideZeroPlayers", "Hide 0% Players drops everyone nobody rosters, so you are left with the players actually worth tracking.", TooltipPosition.Bottom)
    .AddStep("ShowGameMonsterBar", "This toggles the per game monster bar on each row, which shows recent form at a glance.", TooltipPosition.Bottom)
    .AddStep("rm-tour-depth-refresh", "Refresh pulls the latest depth and ownership data.", TooltipPosition.Bottom)
    .Render())

    @* _PageTitleRow removed: its title moved to the header block, its league
       dropdown moved to _Layout and its search is off, so it rendered as an
       empty styled band. *@
    <form method="post" asp-page-handler="Refresh">


        <div class="row m-1 mb-1">
            <div class="col-auto p-1">
                <select asp-for="@Model.SelectedTeamId" class="form-control rm-modern-select" asp-items="ViewBag.TeamList" data-dc-live></select>
            </div>
            <div class="col-auto p-1">
                <button id="rm-tour-depth-refresh" class="btn btn-primary" asp-page-handler="Refresh">Refresh</button>
            </div>
        </div>

        <div class="row m-1 mb-1">
            <div class="col-auto p-1">
                <div class="form-check form-switch rm-switch">
                    <input asp-for="HideZeroPlayers" class="form-check-input" role="switch" data-dc-live>
                    <label class="form-check-label" asp-for="HideZeroPlayers"></label>
                </div>
            </div>
            <div class="col-auto p-1">
                <div class="form-check form-switch rm-switch">
                    <input asp-for="ShowGameMonsterBar" class="form-check-input" role="switch" data-dc-live>
                    <label class="form-check-label" asp-for="ShowGameMonsterBar"></label>
                </div>
            </div>
            <div class="col-auto p-1">
                <div class="form-check form-switch rm-switch">
                    <input asp-for="ShowTotalMonsterBar" class="form-check-input" role="switch" data-dc-live>
                    <label class="form-check-label" asp-for="ShowTotalMonsterBar"></label>
                </div>
            </div>
        </div>

    </form>

    <div id="depthChartsBody" class="rm-live-section" data-l="@Model.SelectedUserLeagueId">
        <partial name="_DepthChartsBody" model="Model" />
    </div>
</div>

@section scripts{
    <script>
        (function () {
            var body = document.getElementById('depthChartsBody');
            if (!body) return;

            function control(name) {
                return document.querySelector('[data-dc-live][name="' + name + '"]');
            }

            var team = control('SelectedTeamId');
            var hideZero = control('HideZeroPlayers');
            var gameBar = control('ShowGameMonsterBar');
            var totalBar = control('ShowTotalMonsterBar');
            var pending = null;

            function query() {
                var p = new URLSearchParams();
                var l = body.getAttribute('data-l');
                if (l && l !== '0') p.set('l', l);
                if (team) p.set('t', team.value);
                if (hideZero) p.set('z', hideZero.checked);
                if (gameBar) p.set('gmb', gameBar.checked);
                if (totalBar) p.set('tmb', totalBar.checked);
                return p;
            }

            function reload() {
                var p = query();
                var url = location.pathname + '?handler=Chart&' + p.toString();
                if (pending) pending.abort();
                pending = new AbortController();
                body.classList.add('rm-live-loading');
                fetch(url, { signal: pending.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) {
                        if (!r.ok) throw new Error('status ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        body.innerHTML = html;
                        history.replaceState(null, '', location.pathname + '?' + p.toString());
                        body.classList.remove('rm-live-loading');
                    })
                    .catch(function (err) {
                        if (err.name === 'AbortError') return;
                        location.href = location.pathname + '?' + p.toString();
                    });
            }

            document.querySelectorAll('[data-dc-live]').forEach(function (el) {
                el.addEventListener('change', reload);
            });
        })();
    </script>
}
