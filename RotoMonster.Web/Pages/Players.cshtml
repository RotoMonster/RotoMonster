@page "{playerId:int?}"

@model PlayersModel
@{
    ViewData["Title"] = "Details";
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
}

<div class="container">

    <form method="get">
        <div class="container ms-3 mb-3" style="max-width: 400px;">
            <div class="input-group">
                <input type="search" id="tags" placeholder="Enter player name" class="form-control" asp-for="SearchTerm" />
                <button class="btn btn-primary ms-1">Search</button>
            </div>
        </div>
    </form>

    @if (Model.Player != null)
    {
        <div>
            <div class="card">
                <div class="card-header">
                    <h1 class="p-0 m-0">
                        @Model.Player.FirstName @Model.Player.LastName
                        @(Model.SeasonPlayer!=null ? Model.SeasonPlayer.Team.Code : "X")
                        @foreach (var psp in Model.PositionSourcePlayers)
                        {
                            <partial name="_ColoredPosition" model="psp.Position" />
                        }
                    </h1>

                    <h4 class="ms-1 mt-1">
                        <span class="pe-2"><partial name="_PlayerHeight" model="Model.Player.Height" /></span>
                        <span class="pe-2">
                            <partial name="_PlayerWeight" model="Model.Player.Weight" />
                        </span>
                        <span class="pe-2">
                            <partial name="_PlayerBirthdate" model="Model.Player.Birthdate" />
                        </span>
                        <span class="pe-2"><partial name="_PlayerDraft" model="Model.Player" /></span>
                        <span class="pe-2"><partial name="_PlayerSalary" model="Model.SeasonPlayer" /></span>
                    </h4>

                    @if (Model.PlayerStatus != null)
                    {
                        <h4 class="mt-1 mb-3">
                            <span class="ps-2 pe-2 me-1" style="@colorLib.GetPlayerStatusTypeStyle(Model.PlayerStatus.PlayerStatusType)">@Model.PlayerStatus.PlayerStatusType.TextFormat.Replace("{t}", "").Trim()</span>
                            <span>@Model.PlayerStatus.Comment</span>
                            <small style="color:black;background-color:#@colorLib.TimeSinceInjuryColorStyle(Model.PlayerStatus)"><partial name="_Timespan" model="Model.PlayerStatus.TimeSince" /></small>
                        </h4>
                    }

                    @if (Model.OwnershipPlayer != null)
                    {
                        <div class="mt-0">
                            <span class="me-2 border ps-1 pe-1" style="background-color:#@colorLib.OwnershipGetPercentColor(Model.OwnershipPlayer.OwnershipPercent)">
                                <partial name="_PlayerOwnershipChange" model="new RotoMonster.Core.PartialViewModels.PlayerOwnershipChangeModel(Model.OwnershipPlayer.OwnershipPercent,Model.OwnershipPlayer.PercentOwnershipChange)" />
                                <small>% Own</small>
                            </span>
                            <span class="border ps-1 pe-1" style="background-color:#@colorLib.ActiveGetPercentColor(Model.OwnershipPlayer.ActivePercent)">
                                <partial name="_PlayerOwnershipChange" model="new RotoMonster.Core.PartialViewModels.PlayerOwnershipChangeModel(Model.OwnershipPlayer.ActivePercent,Model.OwnershipPlayer.PercentActiveChange)" />
                                <small>% Active</small>
                            </span>
                            @if (Model.OwnershipPlayer.IRPercent > 0)
                            {
                                <span class="border ps-1 pe-1 ms-2">
                                    <partial name="_PlayerOwnershipChange" model="new RotoMonster.Core.PartialViewModels.PlayerOwnershipChangeModel(Model.OwnershipPlayer.IRPercent,Model.OwnershipPlayer.PercentActiveChange)" />
                                    <small>% IR</small>
                                </span>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>

        @if (ViewBag.UserLeagueList != null && ViewBag.UserLeagueList.Items.Count > 0)
        {
            <form method="post">
                <div class="mt-2 mb-1 p-2 row">
                    <div class="col-auto p-1">
                        <select asp-for="@Model.SelectedUserLeagueId" class="form-control" asp-items="ViewBag.UserLeagueList" onchange="this.form.submit()"></select>
                    </div>
                    <div class="col-auto p-1">
                        <button class="btn btn-sm btn-primary ms-1" name="refresh">Refresh</button>
                    </div>
                    <div class="col-auto p-1">
                        @if (Model.OwnedInUserLeagues != null && Model.OwnedInUserLeagues.Count > 0)
                        {
                            string note = "";
                            foreach (var userLeague in Model.OwnedInUserLeagues)
                                note += "[" + userLeague.DisplayTitle + "]";
                            <span class="badge bg-success" data-bs-toggle="tooltip" data-html="true" title="@note">
                                Yours in  @Model.OwnedInUserLeagues.Count
                            </span>
                        }
                        @if (Model.AvailableInUserLeagues != null && Model.AvailableInUserLeagues.Count > 0)
                        {
                            string note = "";
                            foreach (var userLeague in Model.AvailableInUserLeagues)
                                note += "[" + userLeague.DisplayTitle + "]";
                            <span class="badge bg-primary" data-bs-toggle="tooltip" data-html="true" title="@note">
                                Available in @Model.AvailableInUserLeagues.Count
                            </span>
                        }
                    </div>
                </div>
            </form>
        }

        <div class="mt-3">
            <partial name="_PlayerTable" model="Model.HistoryTableModel" />
        </div>

        @if (Model.GameLogGames != null && Model.GameLogGames.Count() > 0)
        {
            <div class="container ms-0">
                <table class="@RotoMonster.Core.RMCss.DataTable">
                    <thead class="@RotoMonster.Core.RMCss.DataTableTHead">
                        <tr>
                            <th>Date</th>
                            <th>Value</th>
                            <th>Opp</th>
                            <th>Team</th>
                            @foreach (var dc in Model.HistoryTableModel.BeforeCategories)
                            {
                                <th class="text-nowrap"><partial name="_PlayerTableCategoryTitle" model="@dc.Category" /></th>
                            }
                            @if (Model.HistoryTableModel.UserDisplayCategories != null)
                            {
                                @foreach (var cs in Model.HistoryTableModel.UserDisplayCategories)
                                {
                                    <th class="text-nowrap"><partial name="_PlayerTableCategoryTitle" model="@cs.Category" /></th>
                                }
                            }
                            @foreach (var dc in Model.HistoryTableModel.AfterCategories)
                            {
                                <th class="text-nowrap"><partial name="_PlayerTableCategoryTitle" model="@dc.Category" /></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gameLog in Model.GameLogGames)
                        {
                            @if (gameLog.IsBreak)
                            {
                                <tr><td colspan="50" class="bg-dark"></td></tr>
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        @gameLog.Game.GameDate.ToShortDateString()
                                    </td>

                                    @if (gameLog.StatPlayer != null)
                                    {
                                        <td class="tdr" style="background-color:#@gameLog.ValuePlayer.LeagueValueColor;">@String.Format("{0:#####0.00}", gameLog.ValuePlayer.LeagueValue)</td>
                                    }
                                    else
                                    {
                                        <td />
                                    }

                                    @if (gameLog.StatPlayer != null)
                                    {
                                        @if (gameLog.EaseValuePlayer != null)
                                        {
                                            <td class="tdr text-nowrap" style="background-color:#@gameLog.EaseValuePlayer.LeagueValueColor;">
                                                @gameLog.Game.GetOpponentText(gameLog.StatPlayer.Team)
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @gameLog.Game.GetOpponentText(gameLog.StatPlayer.Team)
                                                @if (gameLog.Game.Number > 1)
                                                {
                                                    <span class="ms-1">#@gameLog.Game.Number</span>
                                                }
                                            </td>
                                        }
                                        <td>@gameLog.StatPlayer.Team.Code</td>
                                    }
                                    else
                                    {
                                        <td />
                                        <td />
                                    }

                                    @if (gameLog.PlayerGameMissed != null)
                                    {
                                        int colspan = 0;
                                        colspan += (Model.HistoryTableModel.BeforeCategories != null ? Model.HistoryTableModel.BeforeCategories.Count : 0);
                                        colspan += (Model.HistoryTableModel.UserDisplayCategories != null ? Model.HistoryTableModel.UserDisplayCategories.Count : 0);
                                        colspan += (Model.HistoryTableModel.AfterCategories != null ? Model.HistoryTableModel.AfterCategories.Count : 0);
                                        <td colspan="@colspan"></td>
                                    }
                                    else
                                    {

                                        if (gameLog.StatPlayer != null)
                                        {
                                            @foreach (var dc in Model.HistoryTableModel.BeforeCategories)
                                            {
                                                var displayFormat = (from df in dc.Category.CategoryPerValues where df.PerValueId == Model.GameLogPerValue.Id select df.DisplayFormat).FirstOrDefault();
                                                <td class="tdr">@String.Format("{0:" + displayFormat + "}", gameLog.StatPlayer.Get(Model.HistoryTableModel.DisplayPerValue, dc.Category.Id))</td>
                                            }

                                            @if (Model.HistoryTableModel.UserDisplayCategories != null)
                                            {
                                                @foreach (var cs in Model.HistoryTableModel.UserDisplayCategories)
                                                {
                                                    var displayFormat = (from df in cs.Category.CategoryPerValues where df.PerValueId == Model.GameLogPerValue.Id select df.DisplayFormat).FirstOrDefault();
                                                    <td class="tdr">@String.Format("{0:" + displayFormat + "}", gameLog.StatPlayer.Get(Model.HistoryTableModel.DisplayPerValue, cs.Category.Id))</td>
                                                }
                                            }

                                            @foreach (var dc in Model.HistoryTableModel.AfterCategories)
                                            {
                                                var displayFormat = (from df in dc.Category.CategoryPerValues where df.PerValueId == Model.GameLogPerValue.Id select df.DisplayFormat).FirstOrDefault();
                                                <td class="tdr">@String.Format("{0:" + displayFormat + "}", gameLog.StatPlayer.Get(Model.HistoryTableModel.DisplayPerValue, dc.Category.Id))</td>
                                            }
                                        }
                                        else
                                        {
                                            int colspan = Model.HistoryTableModel.BeforeCategories.Count + Model.HistoryTableModel.AfterCategories.Count;
                                            colspan += Model.HistoryTableModel.UserDisplayCategories != null ? Model.HistoryTableModel.UserDisplayCategories.Count : 0;

                                            <td colspan="@colspan"></td>
                                        }

                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@section footer{
}

@section scripts{
    <partial name="_PlayerSearchScripts" model='"tags"' />
}
