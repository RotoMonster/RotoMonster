@page "{playerId:int?}"

@model PlayersModel
@{
    ViewData["Title"] = "Details";
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
    bool hasGameLog = Model.GameLogGames != null && Model.GameLogGames.Count() > 0;
    string sportCode = (ViewData["sport"] ?? "").ToString().ToLower();
    string teamCode = Model.SeasonPlayer != null && Model.SeasonPlayer.Team != null ? Model.SeasonPlayer.Team.Code : "FA";
}

<div class="container-fluid px-4 rm-players rm-pp">

    <form method="get" class="rm-pp-search">
        <div class="input-group">
            <input type="search" id="tags" placeholder="Enter player name" class="form-control" asp-for="SearchTerm" />
            <button class="btn btn-primary ms-1">Search</button>
        </div>
    </form>

    @if (Model.Player != null)
    {
        string initials = (string.IsNullOrEmpty(Model.Player.FirstName) ? "" : Model.Player.FirstName.Substring(0, 1))
            + (string.IsNullOrEmpty(Model.Player.LastName) ? "" : Model.Player.LastName.Substring(0, 1));
        <div class="rm-pp-hero">
            <div class="rm-pp-avatar">@initials</div>

            <div class="rm-pp-hero-main">
                <h1 class="rm-pp-name">@Model.Player.FirstName @Model.Player.LastName</h1>
                <div class="rm-pp-sub">
                    <span class="rm-pp-team" style="--pp-team: var(--team-@(sportCode)-@(teamCode.Trim().ToLower()), var(--brand-primary));">@teamCode</span>
                    @foreach (var psp in Model.PositionSourcePlayers)
                    {
                        <span class="rm-pp-pos"><partial name="_ColoredPosition" model="psp.Position" /></span>
                    }
                </div>
                <div class="rm-pp-facts">
                    @if (Model.Player.Height > 0)
                    {
                        <span class="rm-pp-fact"><span class="rm-pp-fact-label">Ht</span><partial name="_PlayerHeight" model="Model.Player.Height" /></span>
                    }
                    @if (Model.Player.Weight > 0)
                    {
                        <span class="rm-pp-fact"><span class="rm-pp-fact-label">Wt</span><partial name="_PlayerWeight" model="Model.Player.Weight" /></span>
                    }
                    @if (Model.Player.Birthdate.Year > 1900)
                    {
                        <span class="rm-pp-fact"><span class="rm-pp-fact-label">Age</span><partial name="_PlayerBirthdate" model="Model.Player.Birthdate" /></span>
                    }
                    @if (Model.Player.RookieYear > 0)
                    {
                        <span class="rm-pp-fact"><span class="rm-pp-fact-label">Draft</span><partial name="_PlayerDraft" model="Model.Player" /></span>
                    }
                    @if (Model.SeasonPlayer != null && Model.SeasonPlayer.Salary.GetValueOrDefault() > 0)
                    {
                        <span class="rm-pp-fact"><span class="rm-pp-fact-label">Salary</span><partial name="_PlayerSalary" model="Model.SeasonPlayer" /></span>
                    }
                </div>
                @if (Model.PlayerStatus != null)
                {
                    <div class="rm-pp-status">
                        <span class="rm-pp-status-type" style="@colorLib.GetPlayerStatusTypeStyle(Model.PlayerStatus.PlayerStatusType)">@Model.PlayerStatus.PlayerStatusType.TextFormat.Replace("{t}", "").Trim()</span>
                        <span class="rm-pp-status-comment">@Model.PlayerStatus.Comment</span>
                        <small class="rm-pp-status-time" style="background-color:#@colorLib.TimeSinceInjuryColorStyle(Model.PlayerStatus)"><partial name="_Timespan" model="Model.PlayerStatus.TimeSince" /></small>
                    </div>
                }
            </div>

            <div class="rm-pp-hero-side">
                @if (Model.OwnershipPlayer != null)
                {
                    <div class="rm-pp-own">
                        <span class="rm-badge rm-badge--inline" style="background-color:#@colorLib.OwnershipGetPercentColor(Model.OwnershipPlayer.OwnershipPercent)">
                            <partial name="_PlayerOwnershipChange" model="new RotoMonster.Models.Shared.PlayerOwnershipChangeModel(Model.OwnershipPlayer.OwnershipPercent,Model.OwnershipPlayer.PercentOwnershipChange)" />
                            <small>% Own</small>
                        </span>
                        <span class="rm-badge rm-badge--inline" style="background-color:#@colorLib.ActiveGetPercentColor(Model.OwnershipPlayer.ActivePercent)">
                            <partial name="_PlayerOwnershipChange" model="new RotoMonster.Models.Shared.PlayerOwnershipChangeModel(Model.OwnershipPlayer.ActivePercent,Model.OwnershipPlayer.PercentActiveChange)" />
                            <small>% Active</small>
                        </span>
                        @if (Model.OwnershipPlayer.IRPercent > 0)
                        {
                            <span class="rm-badge rm-badge--inline rm-badge--outline">
                                <partial name="_PlayerOwnershipChange" model="new RotoMonster.Models.Shared.PlayerOwnershipChangeModel(Model.OwnershipPlayer.IRPercent,Model.OwnershipPlayer.PercentActiveChange)" />
                                <small>% IR</small>
                            </span>
                        }
                    </div>
                }
                @if (ViewBag.UserLeagueList != null && ViewBag.UserLeagueList.Items.Count > 0)
                {
                    <form method="post" id="ppLeaguesForm" class="rm-live-section" data-rm-live>
                        <div class="rm-pp-leagues">
                            <input type="hidden" asp-for="@Model.SelectedUserLeagueId" />
                            <div>
                                <button class="btn btn-sm btn-primary" name="refresh">Refresh</button>
                            </div>
                            <div>
                                @if (Model.OwnedInUserLeagues != null && Model.OwnedInUserLeagues.Count > 0)
                                {
                                    string note = "";
                                    foreach (var userLeague in Model.OwnedInUserLeagues)
                                        note += "[" + userLeague.DisplayTitle + "]";
                                    var tipNote1 = ViewContext.HttpContext.NextTooltipId();
                                    <span class="bm-tooltip-wrap">
                                    <span class="badge bg-success bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipNote1">
                                        Yours in  @Model.OwnedInUserLeagues.Count
                                    </span>
                                    <div class="bm-tooltip-content" id="@tipNote1" role="tooltip">@Html.Raw(note)</div>
                                    </span>
                                }
                                @if (Model.AvailableInUserLeagues != null && Model.AvailableInUserLeagues.Count > 0)
                                {
                                    string note = "";
                                    foreach (var userLeague in Model.AvailableInUserLeagues)
                                        note += "[" + userLeague.DisplayTitle + "]";
                                    var tipNote2 = ViewContext.HttpContext.NextTooltipId();
                                    <span class="bm-tooltip-wrap">
                                    <span class="badge bg-primary bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipNote2">
                                        Available in @Model.AvailableInUserLeagues.Count
                                    </span>
                                    <div class="bm-tooltip-content" id="@tipNote2" role="tooltip">@Html.Raw(note)</div>
                                    </span>
                                }
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="rm-pp-card rm-pp-stats">
            <div class="rm-pp-stats-bar">
                <div class="rm-pp-tabs" role="tablist">
                    <button type="button" class="rm-pp-tab rm-pp-tab--on" data-pp-tab="rm-pp-season">Season stats</button>
                    @if (hasGameLog)
                    {
                        <button type="button" class="rm-pp-tab" data-pp-tab="rm-pp-gamelog">Game log</button>
                    }
                </div>
                <button type="button" class="rm-pp-toggle" data-pp-toggle>Show all stats</button>
            </div>

            <div class="rm-pp-panel rm-profile-table" id="rm-pp-season">
                <partial name="_PlayerTable" model="Model.HistoryTableModel" />
            </div>

            @if (hasGameLog)
            {
                <div class="rm-pp-panel rm-profile-table" id="rm-pp-gamelog" style="display:none;">
                <table class="@RotoMonster.Core.RMCss.DataTable">
                    <thead class="@RotoMonster.Core.RMCss.DataTableTHead">
                        <tr>
                            <th>Date</th>
                            <th>Value</th>
                            <th>Opp</th>
                            <th>Team</th>
                            @foreach (var dc in Model.HistoryTableModel.BeforeCategories)
                            {
                                <th class="text-nowrap"><partial name="_PlayerTableCategoryTitle" model="@dc.Category" /></th>
                            }
                            @if (Model.HistoryTableModel.UserDisplayCategories != null)
                            {
                                @foreach (var cs in Model.HistoryTableModel.UserDisplayCategories)
                                {
                                    <th class="text-nowrap"><partial name="_PlayerTableCategoryTitle" model="@cs.Category" /></th>
                                }
                            }
                            @foreach (var dc in Model.HistoryTableModel.AfterCategories)
                            {
                                <th class="text-nowrap"><partial name="_PlayerTableCategoryTitle" model="@dc.Category" /></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gameLog in Model.GameLogGames)
                        {
                            @if (gameLog.IsBreak)
                            {
                                <tr><td colspan="50" class="bg-dark"></td></tr>
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        @gameLog.Game.GameDate.ToShortDateString()
                                    </td>

                                    @if (gameLog.StatPlayer != null)
                                    {
                                        <td class="tdr" style="background-color:#@gameLog.ValuePlayer.LeagueValueColor;">@String.Format("{0:#####0.00}", gameLog.ValuePlayer.LeagueValue)</td>
                                    }
                                    else
                                    {
                                        <td />
                                    }

                                    @if (gameLog.StatPlayer != null)
                                    {
                                        @if (gameLog.EaseValuePlayer != null)
                                        {
                                            <td class="tdr text-nowrap" style="background-color:#@gameLog.EaseValuePlayer.LeagueValueColor;">
                                                @gameLog.Game.GetOpponentText(gameLog.StatPlayer.Team)
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @gameLog.Game.GetOpponentText(gameLog.StatPlayer.Team)
                                                @if (gameLog.Game.Number > 1)
                                                {
                                                    <span class="ms-1">#@gameLog.Game.Number</span>
                                                }
                                            </td>
                                        }
                                        <td>@gameLog.StatPlayer.Team.Code</td>
                                    }
                                    else
                                    {
                                        <td />
                                        <td />
                                    }

                                    @if (gameLog.PlayerGameMissed != null)
                                    {
                                        int colspan = 0;
                                        colspan += (Model.HistoryTableModel.BeforeCategories != null ? Model.HistoryTableModel.BeforeCategories.Count : 0);
                                        colspan += (Model.HistoryTableModel.UserDisplayCategories != null ? Model.HistoryTableModel.UserDisplayCategories.Count : 0);
                                        colspan += (Model.HistoryTableModel.AfterCategories != null ? Model.HistoryTableModel.AfterCategories.Count : 0);
                                        <td colspan="@colspan"></td>
                                    }
                                    else
                                    {

                                        if (gameLog.StatPlayer != null)
                                        {
                                            @foreach (var dc in Model.HistoryTableModel.BeforeCategories)
                                            {
                                                var displayFormat = (from df in dc.Category.CategoryPerValues where df.PerValueId == Model.GameLogPerValue.Id select df.DisplayFormat).FirstOrDefault();
                                                <td class="tdr">@String.Format("{0:" + displayFormat + "}", gameLog.StatPlayer.Get(Model.HistoryTableModel.DisplayPerValue, dc.Category.Id))</td>
                                            }

                                            @if (Model.HistoryTableModel.UserDisplayCategories != null)
                                            {
                                                @foreach (var cs in Model.HistoryTableModel.UserDisplayCategories)
                                                {
                                                    var displayFormat = (from df in cs.Category.CategoryPerValues where df.PerValueId == Model.GameLogPerValue.Id select df.DisplayFormat).FirstOrDefault();
                                                    <td class="tdr">@String.Format("{0:" + displayFormat + "}", gameLog.StatPlayer.Get(Model.HistoryTableModel.DisplayPerValue, cs.Category.Id))</td>
                                                }
                                            }

                                            @foreach (var dc in Model.HistoryTableModel.AfterCategories)
                                            {
                                                var displayFormat = (from df in dc.Category.CategoryPerValues where df.PerValueId == Model.GameLogPerValue.Id select df.DisplayFormat).FirstOrDefault();
                                                <td class="tdr">@String.Format("{0:" + displayFormat + "}", gameLog.StatPlayer.Get(Model.HistoryTableModel.DisplayPerValue, dc.Category.Id))</td>
                                            }
                                        }
                                        else
                                        {
                                            int colspan = Model.HistoryTableModel.BeforeCategories.Count + Model.HistoryTableModel.AfterCategories.Count;
                                            colspan += Model.HistoryTableModel.UserDisplayCategories != null ? Model.HistoryTableModel.UserDisplayCategories.Count : 0;

                                            <td colspan="@colspan"></td>
                                        }

                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    }
</div>

@section footer{
}

@section scripts{
    <partial name="_PlayerSearchScripts" model='"tags"' />
    <script>
        (function () {
            function isEmptyValue(text) {
                var t = (text || '').replace(/\s+/g, '');
                if (t === '' || t === '-') return true;
                var n = parseFloat(t.replace(/[,$%]/g, ''));
                return !isNaN(n) && n === 0 && /^-?[0-9.,$%]+$/.test(t);
            }

            function cellsByColumn(table) {
                var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
                return rows.map(function (row) {
                    var out = [], col = 0;
                    Array.prototype.forEach.call(row.children, function (cell) {
                        var span = parseInt(cell.getAttribute('colspan') || '1', 10);
                        out.push({ cell: cell, start: col, span: span });
                        col += span;
                    });
                    return out;
                });
            }

            function setupTable(table) {
                var heads = Array.prototype.slice.call(table.querySelectorAll('thead tr:last-child > th'));
                if (!heads.length) return;
                var rows = cellsByColumn(table);
                var empty = [];

                heads.forEach(function (th, i) {
                    var seen = 0, allEmpty = true;
                    rows.forEach(function (cells) {
                        cells.forEach(function (c) {
                            if (c.span === 1 && c.start === i) {
                                seen++;
                                if (!isEmptyValue(c.cell.textContent)) allEmpty = false;
                            }
                        });
                    });
                    if (seen > 0 && allEmpty) empty.push(i);
                });

                table._pp = { heads: heads, rows: rows, empty: empty, spans: rows.map(function (cells) {
                    return cells.map(function (c) { return c.span; });
                }) };
            }

            function applyHide(table, hide) {
                var pp = table._pp;
                if (!pp) return;
                var hidden = hide ? pp.empty : [];

                pp.heads.forEach(function (th, i) {
                    th.style.display = hidden.indexOf(i) > -1 ? 'none' : '';
                });

                pp.rows.forEach(function (cells, r) {
                    cells.forEach(function (c, k) {
                        var original = pp.spans[r][k];
                        if (original === 1) {
                            c.cell.style.display = hidden.indexOf(c.start) > -1 ? 'none' : '';
                        } else {
                            var removed = 0;
                            for (var x = c.start; x < c.start + original; x++) if (hidden.indexOf(x) > -1) removed++;
                            c.cell.setAttribute('colspan', Math.max(1, original - removed));
                        }
                    });
                });
            }

            function chipify(table) {
                Array.prototype.forEach.call(table.querySelectorAll('tbody td'), function (td) {
                    var bg = td.style.backgroundColor;
                    if (!bg) return;
                    td.style.backgroundColor = '';
                    var m = bg.match(/\d+/g);
                    if (m && m.length >= 3 && +m[0] > 240 && +m[1] > 240 && +m[2] > 240) return;
                    var chip = document.createElement('span');
                    chip.className = 'rm-pp-chip';
                    chip.style.backgroundColor = bg;
                    while (td.firstChild) chip.appendChild(td.firstChild);
                    td.appendChild(chip);
                });
            }

            var tables = Array.prototype.slice.call(document.querySelectorAll('.rm-pp .rm-pp-panel table'));
            tables.forEach(chipify);
            var hiding = true;
            tables.forEach(function (t) { setupTable(t); applyHide(t, hiding); });

            var toggle = document.querySelector('[data-pp-toggle]');
            var anyEmpty = tables.some(function (t) { return t._pp && t._pp.empty.length > 0; });
            if (toggle && !anyEmpty) toggle.style.display = 'none';
            if (toggle) toggle.addEventListener('click', function () {
                hiding = !hiding;
                tables.forEach(function (t) { applyHide(t, hiding); });
                toggle.textContent = hiding ? 'Show all stats' : 'Hide empty stats';
            });

            document.querySelectorAll('[data-pp-tab]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('[data-pp-tab]').forEach(function (other) {
                        var on = other === tab;
                        other.classList.toggle('rm-pp-tab--on', on);
                        var panel = document.getElementById(other.getAttribute('data-pp-tab'));
                        if (panel) panel.style.display = on ? '' : 'none';
                    });
                });
            });
        })();
    </script>
}
