@model RotoMonster.Pages.LineupRowView
@{
    var r = Model.Row;
    bool slotIsPos = !Model.IsMLB || r.IsFeatured || Model.IsBench;
}
@if (r.Player != null)
{
    <div class="rm-lu-row@(r.IsFeatured ? " rm-lu-row--feat" : "")">
        <span class="rm-lu-slot">
            @if (slotIsPos && r.Position != null)
            {
                <partial name="_ColoredPosition" model="r.Position" />
            }
            else
            {
                @r.Slot
            }
        </span>
        <span class="rm-lu-name">
            <span class="rm-lu-ownbadge own-cell text-white">@if (r.OwnDisplay != null) { <partial name="_DisplayPlayerOwn" model="r.OwnDisplay" /> }</span>
            <a asp-page="/Players" asp-route-playerId="@r.Player.Id" asp-route-l="@Model.LeagueId">@r.Player.ForwardName</a>
            @if (!string.IsNullOrEmpty(r.Hand))
            {
                <span class="rm-lu-hand">@r.Hand</span>
            }
            <partial name="_PlayerStatus" model="r.Status" />
        </span>
        <span class="rm-lu-right">
            <partial name="_PlayerOwnership" model="r.Ownership" />
            @if (Model.IsMLB && !r.IsFeatured && !Model.IsBench && r.Position != null)
            {
                <partial name="_ColoredPosition" model="r.Position" />
            }
        </span>
    </div>
}
