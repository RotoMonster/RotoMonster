@model string
@{
    string s = (Model ?? "").Trim().ToLower();
}
<svg class="rm-sport-logo rm-sport-logo--@s" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" style="fill: var(--logo-@s, var(--brand-primary));" />
    @if (s == "nba")
    {
        <g fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round">
            <line x1="32" y1="12" x2="32" y2="52" />
            <line x1="12" y1="32" x2="52" y2="32" />
            <path d="M17 17 C25 22 39 22 47 17" />
            <path d="M17 47 C25 42 39 42 47 47" />
        </g>
    }
    else if (s == "mlb")
    {
        <g fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round">
            <path d="M14 25 C24 30 40 30 50 25" />
            <path d="M14 39 C24 34 40 34 50 39" />
            <line x1="20" y1="24" x2="18" y2="30" />
            <line x1="27" y1="26" x2="26" y2="32" />
            <line x1="37" y1="26" x2="38" y2="32" />
            <line x1="44" y1="24" x2="46" y2="30" />
            <line x1="18" y1="34" x2="20" y2="40" />
            <line x1="26" y1="32" x2="27" y2="38" />
            <line x1="38" y1="32" x2="37" y2="38" />
            <line x1="46" y1="34" x2="44" y2="40" />
        </g>
    }
    else if (s == "nfl")
    {
        <g fill="none" stroke="#fff" stroke-linecap="round">
            <line x1="20" y1="44" x2="44" y2="20" stroke-width="2.5" />
            <line x1="21" y1="35" x2="29" y2="43" stroke-width="4" />
            <line x1="28" y1="28" x2="36" y2="36" stroke-width="4" />
            <line x1="35" y1="21" x2="43" y2="29" stroke-width="4" />
        </g>
    }
    else if (s == "nhl")
    {
        <g fill="none" stroke="#fff" stroke-width="3">
            <ellipse cx="32" cy="26" rx="18" ry="7" />
            <line x1="14" y1="26" x2="14" y2="37" />
            <line x1="50" y1="26" x2="50" y2="37" />
            <path d="M14 37 A18 7 0 0 0 50 37" />
        </g>
    }
</svg>
