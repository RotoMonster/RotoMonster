@using RotoMonster.Core.Libs
@model RotoMonster.Core.DisplayPlayer
@{
    var colorLib = new ColorLib();
    var ownState = colorLib.GetOwnBadgeState(Model);
    var ownKey = Model.SeasonPlayer != null
        ? Model.SeasonPlayer.PlayerId.ToString()
        : Context.NextTooltipId();
}

@if (ownState != OwnBadgeState.None)
{
    var tipId = "bm-tip-own-" + ownKey;
    <span class="bm-tooltip-wrap">
        <span class="@colorLib.GetOwnBadgeCss(ownState) bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@tipId">
            @if (colorLib.IsOwnBadgeStarting(ownState))
            {
                <svg class="own-badge-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M7 4.5v15l12-7.5z" /></svg>
            }
            else if (colorLib.IsOwnBadgeBench(ownState))
            {
                <svg class="own-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4.5v15" /><path d="M16 4.5v15" /></svg>
            }
            else if (colorLib.IsOwnBadgeIR(ownState))
            {
                <svg class="own-badge-icon own-badge-icon--ir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g transform="rotate(45 12 12)"><path d="M 7.5 4 L 16.5 4" /><path d="M 9.5 4 L 9.5 12 L 12 15 L 12 21" /><path d="M 14.5 4 L 14.5 12 L 12 15" /><path d="M 9.5 8.5 L 14.5 8.5" /></g></svg>
            }
            else
            {
                <span class="own-badge-text">WW</span>
            }
            @if (Model.IsMyLastPlayer)
            {
                var lastTipId = "bm-tip-ownlast-" + ownKey;
                <span class="bm-tooltip-wrap">
                    <span class="own-last-marker bm-tooltip-trigger bm-tooltip-trigger--hover"
                          data-bm-tooltip="@lastTipId">@Html.Raw(new Icon(new IconInput { Type = IconType.ArrowDown, Size = 14 }).Render())</span>
                    <div class="bm-tooltip-content" id="@lastTipId" role="tooltip">Your last owned player</div>
                </span>
            }
        </span>
        <div class="bm-tooltip-content" id="@tipId" role="tooltip">@colorLib.GetOwnBadgeTitle(Model, ownState)</div>
    </span>
}
else if (Model.IsMyLastPlayer)
{
    var lastTipIdAlone = "bm-tip-ownlast-" + ownKey;
    <span class="bm-tooltip-wrap">
        <span class="own-last-marker bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@lastTipIdAlone">@Html.Raw(new Icon(new IconInput { Type = IconType.ArrowDown, Size = 14 }).Render())</span>
        <div class="bm-tooltip-content" id="@lastTipIdAlone" role="tooltip">Your last owned player</div>
    </span>
}
