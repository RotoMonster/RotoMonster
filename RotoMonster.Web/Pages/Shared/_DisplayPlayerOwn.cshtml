@model RotoMonster.Core.DisplayPlayer

@if (Model.UserLeagueTeam != null)
{
    @if (Model.IsActive)
    {
    }
    else if (Model.IsIR)
    {
        var tipId = Context.NextTooltipId();
        <span class="bm-tooltip-wrap">
        <span class="ms-1 bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@tipId">IR</span>
        <div class="bm-tooltip-content" id="@tipId" role="tooltip">Injured Reserve</div>
        </span>
    }
    else
    {
        var tipId = Context.NextTooltipId();
        <span class="bm-tooltip-wrap">
        <span class="ms-1 bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@tipId">BN</span>
        <div class="bm-tooltip-content" id="@tipId" role="tooltip">Bench</div>
        </span>
    }

    @if (Model.IsMyLastPlayer)
    {
        var tipId = Context.NextTooltipId();
        <span class="bm-tooltip-wrap">
        <span class="ms-1 bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@tipId">@Html.Raw(new Icon(new IconInput { Type = IconType.ArrowDown, Size = 16 }).Render())</span>
        <div class="bm-tooltip-content" id="@tipId" role="tooltip">Your last owned player</div>
        </span>
    }
}

else if (Model.IsWaiver)
{
    var tipId = Context.NextTooltipId();
    <span class="bm-tooltip-wrap">
    <span class="text-black bm-tooltip-trigger bm-tooltip-trigger--hover"
          data-bm-tooltip="@tipId" style="color:black;">WW</span>
    <div class="bm-tooltip-content" id="@tipId" role="tooltip">On Waiver Wire</div>
    </span>
}
