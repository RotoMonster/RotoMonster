@using RotoMonster.Core.Libs
@model RotoMonster.Core.DisplayPlayer
@{
    var colorLib = new ColorLib();
    var ownState = colorLib.GetOwnBadgeState(Model);
    var ownKey = Model.SeasonPlayer != null
        ? Model.SeasonPlayer.PlayerId.ToString()
        : Context.NextTooltipId();
}

@if (ownState != OwnBadgeState.None)
{
    var tipId = "bm-tip-own-" + ownKey;
    <span class="bm-tooltip-wrap">
        <span class="@colorLib.GetOwnBadgeCss(ownState) bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@tipId">
            @if (colorLib.IsOwnBadgeStarting(ownState))
            {
                <svg class="own-badge-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M8 5.5v13l10.5-6.5z" /></svg>
            }
            else if (colorLib.IsOwnBadgeBench(ownState))
            {
                <svg class="own-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5v14" /><path d="M15 5v14" /></svg>
            }
            else if (colorLib.IsOwnBadgeIR(ownState))
            {
                <svg class="own-badge-icon own-badge-icon--ir" viewBox="24 152 592 336" fill="currentColor"><!--!Font Awesome Free v7.3.1 by @@fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M496 480L544 480C579.3 480 608 451.3 608 416L608 224C608 188.7 579.3 160 544 160L496 160L496 480zM448 160L192 160L192 480L448 480L448 160zM96 160C60.7 160 32 188.7 32 224L32 416C32 451.3 60.7 480 96 480L144 480L144 160L96 160zM248 272C248 258.7 258.7 248 272 248C285.3 248 296 258.7 296 272C296 285.3 285.3 296 272 296C258.7 296 248 285.3 248 272zM368 248C381.3 248 392 258.7 392 272C392 285.3 381.3 296 368 296C354.7 296 344 285.3 344 272C344 258.7 354.7 248 368 248zM248 368C248 354.7 258.7 344 272 344C285.3 344 296 354.7 296 368C296 381.3 285.3 392 272 392C258.7 392 248 381.3 248 368zM368 344C381.3 344 392 354.7 392 368C392 381.3 381.3 392 368 392C354.7 392 344 381.3 344 368C344 354.7 354.7 344 368 344z" /></svg>
            }
            else
            {
                <span class="own-badge-text">WW</span>
            }
        </span>
        <div class="bm-tooltip-content" id="@tipId" role="tooltip">@colorLib.GetOwnBadgeTitle(Model, ownState)</div>
    </span>
}

@if (Model.IsMyLastPlayer)
{
    var lastTipId = "bm-tip-ownlast-" + ownKey;
    <span class="bm-tooltip-wrap">
        <span class="own-last-marker bm-tooltip-trigger bm-tooltip-trigger--hover"
              data-bm-tooltip="@lastTipId">@Html.Raw(new Icon(new IconInput { Type = IconType.ArrowDown, Size = 14 }).Render())</span>
        <div class="bm-tooltip-content" id="@lastTipId" role="tooltip">Your last owned player</div>
    </span>
}
