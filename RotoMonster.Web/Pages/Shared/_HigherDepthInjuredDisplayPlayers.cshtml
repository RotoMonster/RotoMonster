@model List<RotoMonster.Core.DisplayPlayer>

@if (Model != null && Model.Count > 0)
{
    var depthTT = "";
    foreach (var hdp in Model)
    {
        depthTT += "<div>";
        depthTT += " " + hdp.SeasonPlayer.Player.ForwardName;
        depthTT += " " + hdp.DepthPlayer.Depth.ToString();
        if (hdp.PlayerStatus.PlayerStatusType != null)
        {
            depthTT += " " + hdp.PlayerStatus.PlayerStatusType.Title;
        }
        depthTT += "</div>";
    }
    var tipId = Context.NextTooltipId();
<span class="bm-tooltip-wrap">
<span class="bm-tooltip-trigger bm-tooltip-trigger--hover text-primary" data-bm-tooltip="@tipId">
        @Html.Raw(new Icon(new IconInput { Type = IconType.ArrowUp, Size = 16 }).Render())
    </span>
<div class="bm-tooltip-content" id="@tipId" role="tooltip">@Html.Raw(depthTT)</div>
</span>
}
