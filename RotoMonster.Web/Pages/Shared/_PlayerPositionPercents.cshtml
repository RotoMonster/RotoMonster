@model RotoMonster.Core.PartialViewModels.PlayerPositionPercentsModel
@if (Model.PlayerPositionPercents != null)
{
    <div class="ppos">
        @foreach (var position in Model.AllPositions)
        {
            var playerPositionPercent = (from pp in Model.PlayerPositionPercents where pp.DisplayPercent > 0 && pp.Position.Id == position.Id select pp).FirstOrDefault();
            if (playerPositionPercent != null)
            {
                <div style="border-color:#@position.ColorCode;">
                    <span class="m-0 p-0" style="color:#@position.ColorCode;">@playerPositionPercent.DisplayPercent</span>
                </div>
            }
            else
            {
                <div style="border-color:#@position.ColorCode;">&#160;</div>
            }
            @*
                <div style="border-color:#@position.ColorCode;">
                @{
                bool match = false;
                foreach (var playerPositionPercent in Model.PlayerPositionPercents)
                {
                if (playerPositionPercent.Position.Id == position.Id && playerPositionPercent.DisplayPercent > 0)
                {
                match = true;
                }
                }
                if (!match)
                {
                @Html.Raw("&#160;")
                }
                }
                </div>
            *@          }
    </div>
}
