@model RotoMonster.Core.PlayerStatus

@{
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
}

@if (Model != null)
{
    Func<string, string, bool> samePart = (a, b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase)
        || (!a.Contains(' ') && !b.Contains(' ') && a.Length >= 6 && b.Length >= 6 && string.Compare(a, 0, b, 0, 6, StringComparison.OrdinalIgnoreCase) == 0);
    var tipParts = new List<string> { (Model.PlayerStatusType.Title ?? "").Trim() };
    foreach (var piece in (Model.Comment ?? "").Split(" - "))
    {
        var part = piece.Trim();
        if (part.Length > 0 && !tipParts.Any(x => samePart(x, part)))
            tipParts.Add(part);
    }
    string txt = string.Join(" - ", tipParts);
    var tipSubject = (Model.Subject ?? "").Trim();
    if (tipSubject.Length > 0 && !tipParts.Any(x => samePart(x, tipSubject)))
        txt += " (" + tipSubject + ")";

    if (Model.EstimatedReturnDate != null)
        txt += " - est. return " + Model.EstimatedReturnDate.GetValueOrDefault().Month.ToString() + "/" + Model.EstimatedReturnDate.GetValueOrDefault().Day.ToString();

    string tipId = "bm-tip-status-" + Model.Id;

    <span class="bm-tooltip-wrap">
    <span class="badge bm-tooltip-trigger bm-tooltip-trigger--hover" style="margin-left: 3px; @colorLib.GetPlayerStatusTypeStyle(Model.PlayerStatusType)"
      data-bm-tooltip="@tipId">
        @Model.PlayerStatusType.TextFormat.Replace("{t}", "")
        @if (Model.EstimatedGamesToMiss!=null && Model.EstimatedGamesToMiss.Count>1)
        {
            string g = Model.EstimatedGamesToMiss.Count.ToString() + "g";
            <small class="status-badge-count">@g</small>
        }
        @if (Model.TimeSince.TotalHours <= 8)
        {
            <small>
                <partial name="_Timespan" model="Model.TimeSince" />
            </small>
        }
    </span>
    <div class="bm-tooltip-content" id="@tipId" role="tooltip">@txt</div>
    </span>
}
