@using RotoMonster.Models.Shared;
@model RotoMonster.Pages.DepthChartsModel
@{
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
}

<div class="rm-depth-grid">
    @foreach (var depthChartTeamModel in Model.DepthChartTeamModels)
    {
        <div class="card p-2 rm-depth-card" style="border-color:#@ViewData["LogoColor"];">
            <div class="card-header">
                <h2>@depthChartTeamModel.Team.Name</h2>
            </div>

            <div class="card-body">
                <table class="table table-sm small table-bordered w-auto">

                    <thead>
                        <tr>
                            <th>Own</th>
                            <th class="tdc">Pos</th>
                            <th>Player</th>
                            <th>Own%</th>
                            @if (Model.ShowGameMonsterBar)
                            {
                                <th class="tdc">
                                    @{ var tipIdG = ViewContext.HttpContext.NextTooltipId(); }
                                    <span class="bm-tooltip-wrap">
                                    <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipIdG">
                                        @Model.MonsterBar.ColumnTitle(false)<small class="ms-1">game</small>
                                    </span>
                                    <div class="bm-tooltip-content" id="@tipIdG" role="tooltip">@Model.MonsterBar.Tooltip</div>
                                    </span>
                                </th>
                            }
                            @if (Model.ShowTotalMonsterBar)
                            {
                                <th class="tdc">
                                    @{ var tipIdT = ViewContext.HttpContext.NextTooltipId(); }
                                    <span class="bm-tooltip-wrap">
                                    <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipIdT">
                                        @Model.TotalMonsterBar.ColumnTitle(false)<small class="ms-1">total</small>
                                    </span>
                                    <div class="bm-tooltip-content" id="@tipIdT" role="tooltip">@Model.TotalMonsterBar.Tooltip</div>
                                    </span>
                                </th>
                            }
                            @if (Model.ShowPositionPercents)
                            {
                                <th class="tdc">Position %</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var dp in depthChartTeamModel.DisplayPlayers)
                        {
                            <tr>
                                <td class="tdc text-center text-nowrap text-white pe-1 @colorLib.GetDisplayPlayerOwnCss(dp)" style="min-width:40px;">
                                    <partial name="_DisplayPlayerOwn" model="dp" />
                                </td>

                                <td class="tdc text-nowrap">
                                    @if (dp.DepthPlayer != null && dp.DepthPlayer.Position != null)
                                    {
                                        <small><partial name="_ColoredPosition" model="dp.DepthPlayer.Position" /></small>
                                        @dp.DepthPlayer.Depth
                                        @if (dp.DepthPlayer.OwnershipDepthPercent > 0)
                                        {
                                            <small>@String.Format("{0:##0}",dp.DepthPlayer.OwnershipDepthPercent)</small>
                                        }
                                    }
                                    else
                                    {
                                        <small><partial name="_ColoredPosition" model="dp.SeasonPlayer.Player.DefaultPosition" /></small>
                                    }
                                    <partial name="_HigherDepthInjuredDisplayPlayers" model="dp.HigherDepthInjuredDisplayPlayers" />
                                </td>

                                <td class="ps-1 pe-1 text-nowrap">
                                    <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp}" />
                                </td>

                                @if (dp.OwnershipPlayer != null)
                                {
                                    <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipGetPercentColor(dp.OwnershipPlayer.OwnershipPercent)">
                                        @String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)
                                        @if (dp.OwnershipPlayer.PercentOwnershipChange != 0)
                                        {
                                            <small class="rm-badge-change" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.OwnershipPlayer.PercentOwnershipChange)">@String.Format("{0:+##0;-##0;0}", dp.OwnershipPlayer.PercentOwnershipChange)</small>
                                        }
                                    </span></td>
                                }
                                else
                                {
                                    <td />
                                }

                                @if (Model.ShowGameMonsterBar)
                                {
                                    <td class="text-nowrap flex-nowrap">
                                        <partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarGamePlayer, Model.MonsterBar.MonsterBarItems)" />
                                    </td>
                                }

                                @if (Model.ShowTotalMonsterBar)
                                {
                                    <td class="text-nowrap flex-nowrap">
                                        <partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarTotalPlayer, Model.TotalMonsterBar.MonsterBarItems, false, null, true)" />
                                    </td>
                                }

                                @if (Model.ShowPositionPercents)
                                {
                                    <td class="text-nowrap flex-nowrap">
                                        <partial name="_PlayerPositionPercents" model="new PlayerPositionPercentsModel(){AllPositions=Model.AllPositions,PlayerPositionPercents=dp.PlayerPositionPercents}" />
                                    </td>
                                }

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
</div>
