@using RotoMonster.Models.Shared;
@model RotoMonster.Pages.DepthChartsModel
@{
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
    var sportKey = Model.SportKey;
    var mbCount = (Model.ShowGameMonsterBar && Model.MonsterBar != null ? 1 : 0) + (Model.ShowTotalMonsterBar && Model.TotalMonsterBar != null ? 1 : 0);
}

<div class="rm-lu rm-lu--@sportKey rm-dc">
    <div class="rm-dc-grid @("rm-dc-grid--mb" + mbCount)">
        @foreach (var team in Model.DepthChartTeamModels)
        {
            var color = "var(--team-" + sportKey + "-" + (team.Team.Code ?? "").ToLowerInvariant() + ", var(--lu-sport))";
            int run = 0;
            string prevKey = null;
            var groups = team.DisplayPlayers
                .Select(dp =>
                {
                    var pos = dp.DepthPlayer != null && dp.DepthPlayer.Position != null ? dp.DepthPlayer.Position : dp.SeasonPlayer.Player.DefaultPosition;
                    var key = pos != null ? (pos.Abbreviation ?? "").Trim() : "";
                    if (key != prevKey) { run++; prevKey = key; }
                    return new { dp, pos, run };
                })
                .ToList()
                .GroupBy(x => x.run)
                .Select(g => new { Pos = g.First().pos, Players = g.Select(x => x.dp).ToList() })
                .ToList();

            <article class="rm-lu-card rm-dc-card">
                <section class="rm-lu-team" style="--tc:@color">
                    <div class="rm-lu-thead">
                        <span class="rm-lu-tcode" title="@team.Team.Code">@team.Team.Name</span>
                    </div>
                    <div class="rm-dc-head">
                        <span></span>
                        <span class="rm-dc-h-depth">#</span>
                        <span class="rm-dc-h-name">Player</span>
                        <span class="rm-dc-h-right">
                            <span class="rm-dc-h-own">
                                <span>Own</span>
                                <span>Act</span>
                            </span>
                            @if (Model.ShowGameMonsterBar && Model.MonsterBar != null)
                            {
                                var tipG = ViewContext.HttpContext.NextTooltipId();
                                <span class="rm-dc-h-mb bm-tooltip-wrap">
                                    <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipG">@Model.MonsterBar.ColumnTitle(false) &middot; game</span>
                                    <div class="bm-tooltip-content" id="@tipG" role="tooltip">@Model.MonsterBar.Tooltip</div>
                                </span>
                            }
                            @if (Model.ShowTotalMonsterBar && Model.TotalMonsterBar != null)
                            {
                                var tipT = ViewContext.HttpContext.NextTooltipId();
                                <span class="rm-dc-h-mb bm-tooltip-wrap">
                                    <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipT">@Model.TotalMonsterBar.ColumnTitle(false) &middot; total</span>
                                    <div class="bm-tooltip-content" id="@tipT" role="tooltip">@Model.TotalMonsterBar.Tooltip</div>
                                </span>
                            }
                        </span>
                    </div>

                    @foreach (var grp in groups)
                    {
                        var tagPos = grp.Pos;
                        <div class="rm-lu-line rm-dc-group">
                            <div class="rm-lu-line-tag" title="@(tagPos != null ? tagPos.Title : "")">
                                @if (tagPos != null)
                                {
                                    <partial name="_ColoredPosition" model="tagPos" />
                                }
                            </div>
                            <div class="rm-lu-line-rows">
                                @foreach (var dp in grp.Players)
                                {
                                    var ownCss = colorLib.GetDisplayPlayerOwnCss(dp);
                                    <div class="rm-lu-row rm-dc-row">
                                        <span class="rm-lu-slot rm-dc-depth">
                                            @if (dp.DepthPlayer != null && dp.DepthPlayer.Depth > 0)
                                            {
                                                <text>@dp.DepthPlayer.Depth</text>
                                            }
                                        </span>
                                        <span class="rm-lu-name">
                                            @if (!string.IsNullOrWhiteSpace(ownCss))
                                            {
                                                <span class="rm-dc-own text-white @ownCss"><partial name="_DisplayPlayerOwn" model="dp" /></span>
                                            }
                                            <a asp-page="/Players" asp-route-playerId="@dp.SeasonPlayer.PlayerId" asp-route-l="@Model.SelectedUserLeagueId">@dp.SeasonPlayer.Player.ForwardName</a>
                                            @if (dp.Positions != null && dp.Positions.Count > 0)
                                            {
                                                <span class="rm-dc-elig">@string.Join(" \u00b7 ", dp.Positions.Where(x => x != null).Select(x => (x.Abbreviation ?? "").Trim()))</span>
                                            }
                                            <partial name="_PlayerStatus" model="dp.PlayerStatus" />
                                            <span class="rm-dc-injahead"><partial name="_HigherDepthInjuredDisplayPlayers" model="dp.HigherDepthInjuredDisplayPlayers" /></span>
                                        </span>
                                        <span class="rm-lu-right rm-dc-right">
                                            @if (dp.OwnershipPlayer != null)
                                            {
                                                <partial name="_PlayerOwnership" model="dp.OwnershipPlayer" />
                                            }
                                            else
                                            {
                                                <span class="rm-own-pair rm-own-pair--empty"></span>
                                            }
                                            @if (Model.ShowGameMonsterBar && Model.MonsterBar != null)
                                            {
                                                <span class="rm-dc-mb"><partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarGamePlayer, Model.MonsterBar.MonsterBarItems)" /></span>
                                            }
                                            @if (Model.ShowTotalMonsterBar && Model.TotalMonsterBar != null)
                                            {
                                                <span class="rm-dc-mb"><partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarTotalPlayer, Model.TotalMonsterBar.MonsterBarItems, false, null, true)" /></span>
                                            }
                                        </span>
                                    </div>
                                    @if (Model.ShowPositionPercents && dp.PlayerPositionPercents != null && dp.PlayerPositionPercents.Count > 0)
                                    {
                                        <div class="rm-dc-pospct">
                                            <partial name="_PlayerPositionPercents" model="new PlayerPositionPercentsModel() { AllPositions = Model.AllPositions, PlayerPositionPercents = dp.PlayerPositionPercents }" />
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @if (groups.Count == 0)
                    {
                        <div class="rm-lu-none">No players</div>
                    }
                </section>
            </article>
        }
    </div>
</div>
