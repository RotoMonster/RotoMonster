@using RotoMonster.Core

@model PositionValuePlayer

@if (Model != null)
{
    @if (Model.IsStartable)
    {
        var tipId = Context.NextTooltipId();
<span class="bm-tooltip-wrap">
<span class="bm-tooltip-trigger bm-tooltip-trigger--hover small" data-bm-tooltip="@tipId">
            @Html.Raw(new Icon(new IconInput { Type = IconType.Success, Size = 16 }).Render())
        </span>
<div class="bm-tooltip-content" id="@tipId" role="tooltip">Top Player at @Model.MostValuablePosition.Abbreviation</div>
</span>
    }
    <small><partial name="_ColoredPosition" model="Model.MostValuablePosition" /></small>
    @String.Format("{0:#####0.00}",Model.PositionValue)
}
