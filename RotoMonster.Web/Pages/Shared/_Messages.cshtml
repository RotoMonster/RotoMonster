@{
    var msgGroups = new[]
    {
        new { Key = "messages", Type = SystemMessageType.Success },
        new { Key = "errormessages", Type = SystemMessageType.Error },
        new { Key = "warningmessages", Type = SystemMessageType.Warning }
    };
}

@foreach (var group in msgGroups)
{
    if (TempData[group.Key] != null)
    {
        var messages = TempData[group.Key] as IEnumerable<string>;
        if (messages != null)
        {
            foreach (var msg in messages)
            {
                <div class="ms-3 me-3">
                    @Html.Raw(new SystemMessage(new SystemMessageInput
                    {
                        Type = group.Type,
                        Text = System.Net.WebUtility.HtmlEncode(msg)
                    }).Render())
                </div>
            }
        }
    }
}
