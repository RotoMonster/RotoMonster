@using RotoMonster.Core
@model RotoMonster.Models.Shared.PlayerLinkModel

@{
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();

    var uiPlayer = new RotoMonsterUI.DisplayPlayerInput
    {
        PlayerId = Model.DisplayPlayer.SeasonPlayer.Player.Id,
        PlayerName = Model.DisplayPlayer.SeasonPlayer.Player.FirstName + " " + Model.DisplayPlayer.SeasonPlayer.Player.LastName,
        TeamCode = Model.DisplayPlayer.SeasonPlayer.Team.Code,
        Positions = Model.DisplayPlayer.Positions
            .Select(p => new RotoMonsterUI.DisplayPosition
            {
                Abbreviation = p.Abbreviation,
                Color = "#" + p.ColorCode
            }).ToList()
    };
}

@Html.Raw(new RotoMonsterUI.DisplayPlayer(uiPlayer).Render())

@if (Model.DisplayPlayer.PlayerStatus != null)
{
    <partial name="_PlayerStatus" model="Model.DisplayPlayer.PlayerStatus" />
}

@if (Model.DisplayPlayer.RecentArticles != null && Model.DisplayPlayer.RecentArticles.Count > 0)
{
    string articleText = Model.DisplayPlayer.RecentArticles.First().Title;
    if (Model.DisplayPlayer.RecentArticles.Count > 1)
        articleText += " (+" + (Model.DisplayPlayer.RecentArticles.Count - 1).ToString() + ")";
    <a asp-page="/Articles" asp-route-playerid="@Model.Player.Id" class="small" data-bs-toggle="tooltip" data-bs-placement="top" title="@articleText">
        <partial name="_IconArticle" />
    </a>
}

@if (Model.PlayerGameState != null)
{
    var displayPlayerGameState = new DisplayPlayerGameState() { PlayerGameState = Model.PlayerGameState };
    <small>
        <partial name="_PlayerGameState" model="displayPlayerGameState" />
    </small>
}
