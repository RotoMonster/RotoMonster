@using RotoMonster.Models.Shared
@using RotoMonster.Core
@model PositionBoostHashModel
@if (Model != null)
{
    var pvTipId = Context.NextTooltipId();
    <span class="bm-tooltip-wrap">
        <button type="button" class="pv-boost-trigger bm-tooltip-trigger"
                data-bm-tooltip="@pvTipId" aria-label="Position value boosts">@Html.Raw(new Icon(new IconInput { Type = IconType.Info, Size = 15 }).Render())</button>
        <div class="bm-tooltip-content pv-boost-tip" id="@pvTipId" role="tooltip">
            <div class="pv-boost-title">Position Value Boosts</div>
            <div class="pv-boost-note">The more positive the value, the harder it is to find that position.</div>
            <table class="pv-boost-table">
                @foreach (var position in Model.Positions)
                {
                    if (Model.PositionBoostHash.ContainsKey(position.Id))
                    {
                        <tr>
                            <td><partial name="_ColoredPosition" model="position" /></td>
                            <td class="text-nowrap pv-boost-value">
                                <partial name="_ShowPlusIfPositive" model="Model.PositionBoostHash[position.Id]" />
                                @String.Format("{0:#####0.00}", Model.PositionBoostHash[position.Id])
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    </span>
}
