@model RotoMonster.Models.Shared.MonsterBarBadgeCell

@*
    One MonsterBar cell. Split out of _MonsterBarBadge so a cell that needs a
    tooltip wrapper and one that doesn't render from the same definition
    instead of the markup being written twice.
*@

@if (!string.IsNullOrEmpty(Model.BackgroundColor))
{
    <span class="range-badge-cell monster-bar-cell range-badge-cell--shaded @Model.EmphasisClass @Model.PositionClass"
          style="background:@Model.BackgroundColor;">
        <span class="monster-bar-games">@Model.GamesText</span>
        @if (!string.IsNullOrEmpty(Model.MeasureText))
        {
            <span class="monster-bar-measure">@Model.MeasureText</span>
        }
    </span>
}
else
{
    <span class="range-badge-cell monster-bar-cell @Model.EmphasisClass @Model.PositionClass">
        <span class="monster-bar-games">@Model.GamesText</span>
        @if (!string.IsNullOrEmpty(Model.MeasureText))
        {
            <span class="monster-bar-measure">@Model.MeasureText</span>
        }
    </span>
}
