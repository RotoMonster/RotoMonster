@{
    var adminPath = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    string TabCss(bool on) => on ? "rm-admin-tab rm-admin-tab--on" : "rm-admin-tab";
}
<nav class="rm-admin-tabs" aria-label="Admin">
    <a class="@TabCss(adminPath == "/twitterview" || adminPath == "/admintasks")" asp-area="" asp-page="/TwitterView">Monitor</a>
    <a class="@TabCss(adminPath == "/admin")" asp-area="" asp-page="/Admin">Site</a>
</nav>
