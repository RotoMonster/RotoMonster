@using RotoMonster.Models.Shared
@model FrontGameScoresModel
@{
    RotoMonster.Core.Libs.FileLib fileLib = new Core.Libs.FileLib();
    string sportKey = (Model.Sport != null ? Model.Sport.Title : "").Trim().ToLower();
    string periodPrefix = sportKey == "nhl" ? "P" : sportKey == "mlb" ? "Inn " : "Q";
    bool showMine = Model.OwnedGameUserLeagueTeamPlayers != null && Model.OwnedGameUserLeagueTeamPlayers.Count > 0;

    string TeamColor(RotoMonster.Core.Team team)
    {
        if (team == null) return "var(--brand-primary)";
        return "var(--team-" + sportKey + "-" + (team.Code ?? "").Trim().ToLower() + ", var(--brand-primary))";
    }

    string TeamName(RotoMonster.Core.Team team)
    {
        if (team == null) return "";
        return string.IsNullOrWhiteSpace(team.Name) ? team.Code : team.Name;
    }
}

@if (Model.ScheduleGames.Count > 0 || Model.PickedDay)
{
    <div class="card mb-3 bg rm-sb rm-sbc">
        <div class="rm-sb-header">
            <a class="rm-sb-title" asp-page="Scores" title="Scores" asp-route-date="@fileLib.GetDateParameter(Model.ScheduleStartDate)">@Model.Sport.Title Scores</a>
            <span class="rm-sb-count">@Model.ScheduleGames.Count @(Model.ScheduleGames.Count == 1 ? "game" : "games")</span>
        </div>

        @if (Model.ScheduleStartDate == Model.ScheduleEndDate)
        {
            <div class="rm-sb-dates">
                @{
                    DateTime currentDate = Model.ScheduleStartDate.AddDays(-1);
                    while (currentDate <= Model.ScheduleEndDate.AddDays(1))
                    {
                        string buttonTitle = currentDate.DayOfWeek.ToString().Substring(0, 3) + " " + String.Format("{0}/{1}", currentDate.Month, currentDate.Day);
                        string dateCss = currentDate == Model.ScheduleStartDate ? "rm-sb-date rm-sb-date--on" : "rm-sb-date";
                        <button type="button" class="@dateCss" data-sb-date="@currentDate.ToString("yyyy-MM-dd")" title="@buttonTitle">@buttonTitle</button>
                        currentDate = currentDate.AddDays(1);
                    }
                }
            </div>
        }

        <div class="rm-sbc-list">
            @if (Model.ScheduleGames.Count == 0)
            {
                <div class="rm-sb-none">No games on this day.</div>
            }
            @foreach (var game in Model.ScheduleGames)
            {
                bool postponed = game.IsPostponed == true;
                bool finished = game.IsFinished;
                bool live = !finished && !postponed && game.HasStarted;
                bool showScores = finished || live;
                string stateCss = postponed ? "rm-sbc-game--ppd" : finished ? "rm-sbc-game--final" : live ? "rm-sbc-game--live" : "rm-sbc-game--pre";
                bool anyProj = !showScores && (game.ProjectedPoints(Model.Sport, game.AwayTeam) > 0 || game.ProjectedPoints(Model.Sport, game.HomeTeam) > 0);

                <div class="rm-sbc-game @stateCss">
                    <div class="rm-sbc-teams">
                        @foreach (var team in game.GetTeams())
                        {
                            if (team == null) { continue; }
                            int score = game.GetTeamScore(team);
                            int other = game.GetOpponentTeamScore(team);
                            string result = finished ? (score > other ? "rm-sbc-team--won" : score < other ? "rm-sbc-team--lost" : "") : "";
                            double proj = game.ProjectedPoints(Model.Sport, team);
                            <div class="rm-sbc-team @result" style="--tc: @TeamColor(team);">
                                <span class="rm-sbc-badge">@team.Code</span>
                                <span class="rm-sbc-name" title="@TeamName(team)">@TeamName(team)</span>
                                @if (showScores)
                                {
                                    <span class="rm-sbc-score" style="@game.GetTeamStyle(team)">@score</span>
                                }
                                else if (proj > 0)
                                {
                                    <span class="rm-sbc-proj">@proj.ToString("0.0")</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="rm-sbc-side">
                        @if (postponed)
                        {
                            <span class="rm-sbc-state rm-sbc-state--ppd">Postponed</span>
                        }
                        else if (finished)
                        {
                            <span class="rm-sbc-state">Final</span>
                            <a class="rm-sbc-link" asp-page="/Scores" asp-route-g="@game.Id">Box score &rsaquo;</a>
                        }
                        else if (live)
                        {
                            <span class="rm-sbc-state rm-sbc-state--live">@(game.Period > 0 ? periodPrefix + game.Period + (string.IsNullOrEmpty(game.GameClock) ? "" : " " + game.GameClock) : "Live")</span>
                            <span class="rm-sbc-bar"><span style="width:@Math.Max(4, Math.Min(100, game.PercentComplete))%"></span></span>
                            <a class="rm-sbc-link" asp-page="/Scores" asp-route-g="@game.Id">Box score &rsaquo;</a>
                        }
                        else
                        {
                            var until = game.TimeUntilGame;
                            string label = until.TotalMinutes > 0 && until.TotalHours < 1 ? "in " + Math.Ceiling(until.TotalMinutes) + "m" : (Model.ScheduleStartDate != Model.ScheduleEndDate ? game.DayOfWeekString + " " : "") + game.EasternTime.ToString("h:mm tt");
                            <span class="rm-sbc-state" title="@game.EasternTime.ToString("dddd h:mm tt")">@label</span>
                            if (anyProj)
                            {
                                <span class="rm-sbc-sub">projected</span>
                            }
                        }

                        @if (showMine)
                        {
                            var owned = (from gp in Model.OwnedGameUserLeagueTeamPlayers where gp.Game.Id == game.Id select gp).ToList();
                            var activeKeys = new HashSet<string>((from gp in Model.ActiveGameUserLeagueTeamPlayers
                                                                  where gp.Game.Id == game.Id && gp.UserLeagueTeamPlayer != null
                                                                  select gp.UserLeagueTeamPlayer.UserLeagueTeamId + ":" + gp.UserLeagueTeamPlayer.PlayerId));
                            int ownedCount = owned.Count(gp => gp.UserLeagueTeamPlayer != null && gp.UserLeagueTeamPlayer.Player != null);
                            int activeCount = owned.Count(gp => gp.UserLeagueTeamPlayer != null && gp.UserLeagueTeamPlayer.Player != null && activeKeys.Contains(gp.UserLeagueTeamPlayer.UserLeagueTeamId + ":" + gp.UserLeagueTeamPlayer.PlayerId));
                            if (ownedCount > 0)
                            {
                                string detailId = "rm-sb-detail-" + game.Id;
                                <button type="button" class="rm-sb-pill" data-sb-toggle="@detailId" aria-expanded="false" aria-controls="@detailId"
                                        title="@activeCount of your @ownedCount players in this game are active">
                                    <span class="rm-sb-pill-bar"><span style="width:@(activeCount * 100 / ownedCount)%"></span></span>
                                    @activeCount/@ownedCount
                                </button>
                            }
                        }
                    </div>

                    @if (showMine)
                    {
                        var owned = (from gp in Model.OwnedGameUserLeagueTeamPlayers where gp.Game.Id == game.Id select gp).ToList();
                        var activeKeys = new HashSet<string>((from gp in Model.ActiveGameUserLeagueTeamPlayers
                                                              where gp.Game.Id == game.Id && gp.UserLeagueTeamPlayer != null
                                                              select gp.UserLeagueTeamPlayer.UserLeagueTeamId + ":" + gp.UserLeagueTeamPlayer.PlayerId));
                        var rows = owned
                            .Where(gp => gp.UserLeagueTeamPlayer != null && gp.UserLeagueTeamPlayer.Player != null)
                            .Select(gp => new
                            {
                                Name = gp.UserLeagueTeamPlayer.Player.ForwardName,
                                Team = gp.UserLeagueTeamPlayer.UserLeagueTeam != null ? gp.UserLeagueTeamPlayer.UserLeagueTeam.Title : "",
                                Active = activeKeys.Contains(gp.UserLeagueTeamPlayer.UserLeagueTeamId + ":" + gp.UserLeagueTeamPlayer.PlayerId)
                            })
                            .OrderByDescending(r => r.Active)
                            .ThenBy(r => r.Name)
                            .ToList();

                        if (rows.Count > 0)
                        {
                            <div class="rm-sb-detail" id="rm-sb-detail-@game.Id">
                                @foreach (var row in rows)
                                {
                                    <div class="rm-sb-detail-row">
                                        <span class="rm-sb-detail-dot @(row.Active ? "rm-sb-detail-dot--on" : "")"></span>
                                        <span class="rm-sb-detail-name">@row.Name</span>
                                        @if (!row.Active)
                                        {
                                            <span class="rm-sb-detail-benched">benched</span>
                                        }
                                        <span class="rm-sb-detail-team">@row.Team</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <div class="rm-scores-tz">@RotoMonster.Core.Game.DisplayZoneName &middot; <a asp-page="/DisplaySettings" asp-fragment="timezone">Change timezone</a></div>
    </div>
}
