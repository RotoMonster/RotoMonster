@model RotoMonster.Models.Shared.PlayerPositionPercentsModel
@if (Model.PlayerPositionPercentOvers != null)
{
    <div class="ppos">
        <div style="background-color:#@Model.EstimatedUpsideColorCode; color:#bfbfbf;">
            @if (Model.EstimatedUpside >= 0)
            {
                var tipId = Context.NextTooltipId();
<span class="bm-tooltip-wrap">
<span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipId">
                    <partial name="_IconUpside" />
                </span>
<div class="bm-tooltip-content" id="@tipId" role="tooltip">@Math.Abs(Model.EstimatedUpside)% upside</div>
</span>
            }
            else
            {
                var tipId = Context.NextTooltipId();
<span class="bm-tooltip-wrap">
<span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipId">
                    <partial name="_IconDownside" />
                </span>
<div class="bm-tooltip-content" id="@tipId" role="tooltip">@Math.Abs(Model.EstimatedUpside)% downside</div>
</span>
            }
        </div>

        @foreach (var position in Model.AllPositions)
        {
            var playerPositionPercentOver = (from pp in Model.PlayerPositionPercentOvers where pp.NormalPlayerPositionPercent.DisplayPercent > 0 && pp.Position.Id == position.Id select pp).FirstOrDefault();
            if (playerPositionPercentOver != null)
            {
                <div class="pos-border-@(position.Abbreviation.Trim().ToLower())" style="background-color:#@playerPositionPercentOver.PercentColorCode;">
                    <span class="m-0 p-0 pos-@(position.Abbreviation.Trim().ToLower())">@playerPositionPercentOver.NormalPlayerPositionPercent.DisplayPercent</span>
                </div>
            }
        }
    </div>
}
