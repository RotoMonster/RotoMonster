@page
@model RotoMonster.Pages.UserLeagues.ImportModel
@{
    ViewData["Title"] = "Import";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@*
    Tabs per provider, each showing how many leagues are available and how many
    are already imported, so nothing has to be clicked to see where things
    stand.

    Yahoo lists through the provider layer and imports in bulk. ESPN and
    FanTrax have no provider implementation yet, so they keep their existing
    per league Import link inside the same tab.
*@

<h1>Your Leagues</h1>

<div class="rm-import-tabs">
    @foreach (var tab in Model.Tabs)
    {
        var isActive = tab.ProviderName == Model.ActiveTab;
        <a class="rm-import-tab @(isActive ? "rm-import-tab--active" : "")"
           asp-page="./Import" asp-route-tab="@tab.ProviderName">
            <span class="rm-import-tab-name">@tab.ProviderName</span>
            @if (!tab.IsConnected)
            {
                <span class="rm-import-tab-count rm-import-tab-count--off">Not connected</span>
            }
            else if (tab.IsCustom)
            {
                <span class="rm-import-tab-count">@tab.TotalCount @(tab.TotalCount == 1 ? "league" : "leagues")</span>
            }
            else if (tab.SupportsBulkImport)
            {
                <span class="rm-import-tab-count">@tab.ImportedCount of @tab.TotalCount imported</span>
            }
            else
            {
                <span class="rm-import-tab-count">@tab.TotalCount @(tab.TotalCount == 1 ? "league" : "leagues")</span>
            }
        </a>
    }
</div>

@foreach (var tab in Model.Tabs.Where(t => t.ProviderName == Model.ActiveTab))
{
    <div class="rm-import-panel">

        @if (tab.IsCustom)
        {
            <p class="rm-import-lead">
                Leagues you created yourself, or that came from a provider RM no
                longer connects to. They can't be re-imported, but you can still
                edit or remove them.
            </p>
        }
        else if (!tab.IsConnected)
        {
            @* The Yahoo panel needs the authorization url, and a partial taking
               just the provider name cannot reach the page model. *@
            ViewData["YahooUrl"] = Model.YahooUrl;
            <partial name="_ImportConnect" model="tab.ProviderName" />
        }
        else
        {
            <div class="rm-import-connection">
                <span class="rm-import-connection-status">
                    <span class="rm-import-dot"></span>@tab.ProviderName connected
                </span>
                <form method="post">
                    <button type="submit" class="rm-import-linkbtn"
                            asp-page-handler="@(tab.Slug == "espn" ? "ESPNDisconnect" : tab.Slug == "fantrax" ? "FanTraxDisconnect" : "YahooDisconnect")">
                        Disconnect
                    </button>
                </form>
            </div>

            @if (!string.IsNullOrEmpty(tab.ErrorMessage))
            {
                <div class="rm-import-error">
                    @tab.ErrorMessage
                    @if (tab.NeedsReauthorization)
                    {
                        <div>You will need to connect @tab.ProviderName again.</div>
                    }
                </div>
            }

            @if (tab.SupportsBulkImport)
            {
                @if (tab.Leagues.Count == 0 && string.IsNullOrEmpty(tab.ErrorMessage))
                {
                    <p class="rm-import-empty">No @tab.ProviderName leagues found for this season.</p>
                }
                else if (tab.Leagues.Count > 0)
                {
                    var selectable = tab.Leagues.Count(l => !l.IsImported);

                    <form method="post">
                        <input type="hidden" name="provider" value="@tab.ProviderName" />

                        @if (tab.IsCustom)
                        {
                            <text></text>
                        }
                        else if (selectable > 0)
                        {
                            <p class="rm-import-lead">
                                Tick the leagues you want, then choose <b>Import selected</b>.
                                You can import them all at once.
                            </p>
                        }
                        else
                        {
                            <p class="rm-import-lead">
                                All of your @tab.ProviderName leagues are imported.
                            </p>
                        }

                        <table class="rm-import-table">
                            <thead>
                                <tr>
                                    <th class="rm-import-check"></th>
                                    <th>League</th>
                                    <th class="rm-import-id">League ID</th>
                                    <th>Your team</th>
                                    <th class="rm-import-status">Status</th>
                                    <th class="rm-import-action">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var league in tab.Leagues)
                                {
                                    <tr class="@(league.IsImported ? "rm-import-row--done" : "rm-import-row--pick")">
                                        <td class="rm-import-check">
                                            @if (!league.IsImported)
                                            {
                                                <label class="bm-checkbox">
                                                    <input type="checkbox" name="SelectedLeagueIds"
                                                           value="@league.LeagueId"
                                                           aria-label="Import @league.Title" />
                                                </label>
                                            }
                                        </td>
                                        <td class="rm-import-name">
                                            @if (league.IsImported)
                                            {
                                                <a asp-page="./Edit" asp-route-id="@league.UserLeagueId">@league.Title</a>
                                            }
                                            else
                                            {
                                                @league.Title
                                            }
                                        </td>
                                        <td class="rm-import-id">
                                            @if (string.IsNullOrEmpty(league.ProviderLeagueId))
                                            {
                                                <span class="rm-import-muted">&mdash;</span>
                                            }
                                            else
                                            {
                                                <span class="rm-import-mono">@league.ProviderLeagueId</span>
                                            }
                                        </td>
                                        <td class="rm-import-team">
                                            @if (string.IsNullOrEmpty(league.MyTeamTitle))
                                            {
                                                <span class="rm-import-muted">&mdash;</span>
                                            }
                                            else
                                            {
                                                @league.MyTeamTitle
                                            }
                                        </td>
                                        <td class="rm-import-status">
                                            @if (!league.IsImported)
                                            {
                                                <span class="rm-import-pill">Available</span>
                                            }
                                            else if (league.TrackLeague)
                                            {
                                                <span class="rm-import-pill rm-import-pill--done">Tracked</span>
                                            }
                                            else
                                            {
                                                <span class="rm-import-pill">Not tracked</span>
                                            }
                                            @if (league.NotAtProvider)
                                            {
                                                @* It exists here but the provider stopped
                                                   returning it, so say so rather than
                                                   leaving the user to wonder. *@
                                                <div class="rm-import-muted">Not at @tab.ProviderName</div>
                                            }
                                        </td>
                                        <td class="rm-import-action">
                                            @if (league.IsImported)
                                            {
                                                <button type="submit" class="rm-import-linkbtn"
                                                        asp-page-handler="ToggleTrack"
                                                        asp-route-userLeagueId="@league.UserLeagueId"
                                                        asp-route-provider="@tab.ProviderName">
                                                    @(league.TrackLeague ? "Untrack" : "Track")
                                                </button>
                                                <a class="rm-import-linkbtn" asp-page="./Edit"
                                                   asp-route-id="@league.UserLeagueId">Edit</a>
                                                <button type="submit" class="rm-import-linkbtn rm-import-linkbtn--danger"
                                                        asp-page-handler="RemoveLeague"
                                                        asp-route-userLeagueId="@league.UserLeagueId"
                                                        asp-route-provider="@tab.ProviderName">
                                                    Remove
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (selectable > 0 && !tab.IsCustom)
                        {
                            <div class="rm-import-actions">
                                <button type="submit" class="modern-filter-btn modern-filter-btn-primary"
                                        asp-page-handler="ImportSelected"
                                        asp-route-provider="@tab.ProviderName">
                                    Import selected
                                </button>
                                <button type="button" class="rm-import-linkbtn rm-import-selectall">
                                    Select all
                                </button>
                                <span class="rm-import-hint">
                                    @selectable @(selectable == 1 ? "league" : "leagues") available to import
                                </span>
                            </div>
                        }
                    </form>
                }

                @if (tab.ProviderName == RotoMonster.Pages.UserLeagues.ImportModel.FanTraxProvider)
                {
                    @* Kept as a fallback. The list covers the normal case now,
                       but a league the Secret ID does not reach can still be
                       added by id. *@
                    <form method="post" class="rm-import-manual">
                        <h6>Import using a FanTrax league ID</h6>
                        <p>
                            Your league ID is in the URL of any league page. In
                            https://www.fantrax.com/fantasy/league/<b>t0xqjo74kpm0ki7k</b>/home
                            the ID is <b>t0xqjo74kpm0ki7k</b>.
                        </p>
                        <div class="rm-import-manual-row">
                            <input asp-for="FanTraxLeagueId" placeholder="FanTrax League ID" class="rm-import-input" />
                            <button class="modern-filter-btn modern-filter-btn-secondary" asp-page-handler="ImportFanTrax">Import</button>
                        </div>
                    </form>
                }
            }
            else
            {
                @if (tab.LegacyTable != null)
                {
                    <partial name="_UserLeagueTable" model="tab.LegacyTable" />
                }
            }
        }
    </div>
}

@*
    Per league results after an import. Shown rather than folded into one
    message so a league that failed says why, next to the ones that worked.
*@
@if (Model.ImportResult != null && Model.ImportResult.Leagues.Count > 0)
{
    <div class="rm-import-panel rm-import-panel--results">
        <h5>Import results</h5>
        <table class="rm-import-table">
            <thead>
                <tr>
                    <th>League</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.ImportResult.Leagues)
                {
                    <tr>
                        <td class="rm-import-name">@(string.IsNullOrEmpty(entry.Title) ? entry.LeagueId : entry.Title)</td>
                        <td>
                            @if (entry.Imported)
                            {
                                <span class="rm-import-pill rm-import-pill--done">Imported</span>
                                @if (entry.MissingPlayerCount > 0)
                                {
                                    <span class="rm-import-muted"> @entry.MissingPlayerCount players not matched</span>
                                }
                                @foreach (var warning in entry.Warnings)
                                {
                                    <div class="rm-import-muted">@warning</div>
                                }
                            }
                            else if (entry.Skipped)
                            {
                                <span class="rm-import-muted">@entry.Message</span>
                            }
                            else
                            {
                                <span class="rm-import-pill rm-import-pill--failed">Failed</span>
                                <div class="rm-import-muted">@entry.Message</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="rm-import-panel">
    <h5>Create a custom league</h5>
    <p class="rm-import-muted">
        Use this if you don't play on Yahoo!, FanTrax or ESPN. It creates a league
        with default settings that you can then edit.
    </p>
    <form method="post">
        <button class="modern-filter-btn modern-filter-btn-secondary" asp-page-handler="CustomLeague">Create league</button>
    </form>
</div>

@section Scripts {
    <script>
        // Select all ticks only the rows that still have a checkbox, so
        // already imported leagues cannot be selected by accident.
        // Clicking anywhere on a row that can be imported toggles it, since a
        // 14px box is a small target for what is the main action on the page.
        document.querySelectorAll('.rm-import-row--pick').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'BUTTON'
                    || e.target.tagName === 'A' || e.target.tagName === 'LABEL') return;

                var box = row.querySelector('input[type=checkbox]');
                if (box) box.checked = !box.checked;
            });
        });

        // Toggles rather than only selecting, so the same control undoes it.
        document.querySelectorAll('.rm-import-selectall').forEach(function (toggle) {
            toggle.addEventListener('click', function () {
                var form = toggle.closest('form');
                if (!form) return;

                var boxes = form.querySelectorAll('tbody input[type=checkbox]');
                if (!boxes.length) return;

                var selectAll = Array.prototype.some.call(boxes, function (box) {
                    return !box.checked;
                });

                boxes.forEach(function (box) { box.checked = selectAll; });
                toggle.textContent = selectAll ? 'Clear all' : 'Select all';
            });
        });
    </script>
}
