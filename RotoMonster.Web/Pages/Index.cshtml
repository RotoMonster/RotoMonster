@page
@model IndexModel
@{
    ViewData["Title"] = "";
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
    RotoMonster.Core.Libs.FileLib fileLib = new Core.Libs.FileLib();
}

<div class="container-fluid px-4 rm-front">

    @Html.Raw(new Tour("front-tour")
        .WithManualTrigger()
        .AddStep("rm-tour-front-league", "Each league you import gets a card like this with your team and roster.", TooltipPosition.Bottom)
        .AddStep("rm-tour-front-refresh", "Refresh pulls your latest roster. Rosters also refresh on their own every few hours.", TooltipPosition.Bottom)
        .AddStep("rm-tour-front-scores", "Today's games and live scores. Click Box score on a game for the full stats.", TooltipPosition.Bottom)
        .AddStep("rm-tour-front-inj", "The latest injuries, with your players first. All injuries opens the full list.", TooltipPosition.Bottom)
        .Render())

    <script>
        document.addEventListener("click", function (e) {
            if (!e.target.closest || !e.target.closest('[data-start-tour="front-tour"]')) return;
            [["rm-tour-front-league", "#rmLeagueGrid .card-header, #rmLeagueGrid .rm-front-empty"], ["rm-tour-front-refresh", '#rmLeagueGrid a[title="Refresh Rosters"]'], ["rm-tour-front-scores", "#FrontGameScoresContainer .rm-sb-header, #FrontGameScoresContainer .rm-sb-title"], ["rm-tour-front-inj", ".rm-inj .card-header"]].forEach(function (x) {
                var old = document.getElementById(x[0]);
                if (old) old.removeAttribute("id");
                var el = document.querySelector(x[1]);
                if (el && !el.id) el.id = x[0];
            });
        }, true);
    </script>
    @{
        int monsterBotPlayerCount = 0;
        foreach (var view in Model.UserLeagueViews)
            monsterBotPlayerCount += (view.MonsterBotPlayers != null ? view.MonsterBotPlayers.Count : 0);
        if (monsterBotPlayerCount > 0)
        {
            <div class="alert alert-warning container text-center"><partial name="_MonsterBotIcon" /> Check MonsterBot Recommendations (@monsterBotPlayerCount)</div>
        }
    }

    <div class="mb-2 ms-1 rm-front-actions">
        @if (Model.UserLeagueViews.Count > 0)
        {
            <a class="btn btn-primary" asp-page="./UserLeagues/Import">Add Leagues</a>
        }
        @Html.Raw(new PageGuide("front-guide")
            .WithTitle("Home")
            .WithPurpose("Your home page pulls together your leagues, today's games and the latest injuries, so you can check everything in one place.")
            .AddSection("Your leagues", "<p>Each league you import gets its own card with your team, your roster and how your players are doing.</p><p>The gear icon opens the league's settings and the refresh icon pulls your latest roster. Rosters also refresh on their own every few hours.</p>")
            .AddSection("MonsterBot", "<p><strong>MonsterBot Rating</strong> shows how your roster stacks up by average own and start percent.</p><p><strong>MonsterBot Recommendations</strong> are moves worth making, and <strong>Top Free Agents</strong> are the best players available in that league. The banner at the top tells you when there are recommendations to check.</p>")
            .AddSection("Scores", "<p>The scores box shows the day's games with live scores. Click <strong>Box score</strong> on any game for the full stats.</p>")
            .AddSection("Recent injuries", "<p>The latest injury news, with your players first. <strong>All injuries</strong> opens the full list.</p>")
            .AddSection("Waiver trends and scoring log", "<p><strong>Waiver Trends</strong> shows the players being added the most right now. The <strong>Scoring Log</strong> shows big games from your players as they happen.</p>")
            .WithTourId("front-tour")
            .Render())
    </div>

    <div class="row rm-front-row">
        <div class="col-auto p-2 rm-front-side">

            @if (Model.RecentArticles.Count > 0)
            {
                <div class="card mb-3 border-success bg">
                    <div class="card-header text-nowrap">
                        <div class="rm-sb-header"><a class="rm-sb-title" href="#RecentArcticles" data-bs-toggle="collapse">Recent Articles</a><span class="rm-sb-count">@Model.RecentArticles.Count articles</span></div>
                        <div id="RecentArcticles" class="collapse">
                            <div class="card-body p-2">
                                @foreach (var a in Model.RecentArticles)
                                {
                                    <div>
                                        <partial name="_IconArticle" />
                                        <a asp-page="/Articles" asp-route-articleid="@a.Id" class="small">
                                            @a.Title
                                        </a>
                                        <small class="text-muted">
                                            <partial name="_Timespan" model="a.TimeSince" />
                                        </small>
                                    </div>
                                }
                                <div class="mt-1 small">
                                    <a asp-page="./Articles" alt="View Articles" title="View Articles">view all recent</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.GameScoringAlertDisplayPlayers.Count > 0)
            {
                <div class="card mb-3 border-success bg">
                    <div class="card-header text-nowrap">
                        <div class="rm-sb-header"><a class="rm-sb-title" href="#ScoringLog" data-bs-toggle="collapse">Scoring Log</a></div>
                    </div>
                    <div id="ScoringLog" class="collapse">
                        <div class="card-body p-2">
                            <table class="table table-sm small rm-front-list">
                                @foreach (var dp in Model.GameScoringAlertDisplayPlayers)
                                {
                                    <tr>
                                        <td style="background-color:#@colorLib.GetTimeSpanColor(dp.GameScoringAlert.TimeSince,.5)">
                                            <partial name="_TimeSpan" model="dp.GameScoringAlert.TimeSince" />
                                        </td>

                                        <td class="ps-1 pe-1">
                                            <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp}" />
                                        </td>

                                        <td>
                                            @dp.GameScoringAlert.Category.Title
                                        </td>

                                        <td>
                                            <small>#</small>
                                            <span>@dp.GameScoringAlert.CurrentValue</span>
                                        </td>

                                        <td class="tdc text-nowrap">
                                            @if (dp.DepthPlayer != null && dp.DepthPlayer.Position != null)
                                            {
                                                <small><partial name="_ColoredPosition" model="dp.DepthPlayer.Position" /></small>
                                                @dp.DepthPlayer.Depth
                                            }
                                            <partial name="_HigherDepthInjuredDisplayPlayers" model="dp.HigherDepthInjuredDisplayPlayers" />
                                        </td>

                                        <td class="tdc">
                                            <partial name="_GameState" model="new RotoMonster.Models.Shared.GameStateViewModel(){Game=dp.Game,Sport=Model.Sport}" />
                                        </td>

                                        @if (dp.NoWaiverOwnershipPlayer != null)
                                        {
                                            <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.NoWaiverOwnershipPlayer.PercentOwnershipChange)">
                                                @if (dp.NoWaiverOwnershipPlayer.PercentOwnershipChange != 0)
                                                {
                                                    <partial name="_ShowPlusIfPositive" model="dp.NoWaiverOwnershipPlayer.PercentOwnershipChange" />

                                                    @String.Format("{0:##0}", dp.NoWaiverOwnershipPlayer.PercentOwnershipChange)
                                                }
                                            </span></td>
                                        }
                                        else
                                        {
                                            <td />
                                        }
                                        <td class="ps-1 pe-1">
                                            @if (dp.OwnedInUserLeagues != null && dp.OwnedInUserLeagues.Count > 0)
                                            {
                                                var tt = "<div>Owned:</div>";
                                                foreach (var ul in dp.OwnedInUserLeagues)
                                                {
                                                    tt += "<div>" + ul.DisplayTitle + "<div>";
                                                }
                                                var tipTt1 = ViewContext.HttpContext.NextTooltipId();
                                                <span class="bm-tooltip-wrap">
                                                <span class="badge bg-success bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipTt1">
                                                    @dp.OwnedInUserLeagues.Count
                                                </span>
                                                <div class="bm-tooltip-content" id="@tipTt1" role="tooltip">@Html.Raw(tt)</div>
                                                </span>
                                            }
                                        </td>
                                        <td class="ps-1 pe-1">
                                            @if (dp.AvailableInUserLeagues != null && dp.AvailableInUserLeagues.Count > 0)
                                            {
                                                var tt = "<div>Available:</div>";
                                                foreach (var ul in dp.AvailableInUserLeagues)
                                                {
                                                    tt += "<div>" + ul.DisplayTitle + "<div>";
                                                }
                                                var tipTt2 = ViewContext.HttpContext.NextTooltipId();
                                                <span class="bm-tooltip-wrap">
                                                <span class="badge bg-info bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipTt2">
                                                    @dp.AvailableInUserLeagues.Count
                                                </span>
                                                <div class="bm-tooltip-content" id="@tipTt2" role="tooltip">@Html.Raw(tt)</div>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div id="FrontGameScoresContainer">...</div>

            @if (Model.TrendingDisplayPlayers.Count > 0)
            {
                <div class="card mb-3 border-info bg">
                    <div class="card-header text-nowrap">
                        <div class="rm-sb-header"><a class="rm-sb-title" href="#WaiverTrends" data-bs-toggle="collapse">@Model.Sport.Title Waiver Trends</a></div>
                    </div>
                    <div id="WaiverTrends" class="collapse.show">
                        <div class="card-body p-2">
                            <table class="table table-sm small rm-front-list">
                                @foreach (var dp in Model.TrendingDisplayPlayers)
                                {
                                    <tr>
                                        <td class="ps-1 pe-1">
                                            <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp}" />
                                        </td>

                                        <td class="tdc text-nowrap">
                                            @if (dp.DepthPlayer != null && dp.DepthPlayer.Position != null)
                                            {
                                                <small><partial name="_ColoredPosition" model="dp.DepthPlayer.Position" /></small>
                                                @dp.DepthPlayer.Depth
                                            }
                                            <partial name="_HigherDepthInjuredDisplayPlayers" model="dp.HigherDepthInjuredDisplayPlayers" />
                                        </td>

                                        @if (dp.NoWaiverOwnershipPlayer != null)
                                        {
                                            <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.NoWaiverOwnershipPlayer.PercentOwnershipChange)">
                                                @if (dp.NoWaiverOwnershipPlayer.PercentOwnershipChange != 0)
                                                {
                                                    <partial name="_ShowPlusIfPositive" model="dp.NoWaiverOwnershipPlayer.PercentOwnershipChange" />

                                                    @String.Format("{0:##0}", dp.NoWaiverOwnershipPlayer.PercentOwnershipChange)
                                                }
                                            </span></td>
                                        }
                                        else
                                        {
                                            <td />
                                        }
                                        <td class="ps-1 pe-1">
                                            @if (dp.OwnedInUserLeagues != null && dp.OwnedInUserLeagues.Count > 0)
                                            {
                                                var tt = "<div>Owned:</div>";
                                                foreach (var ul in dp.OwnedInUserLeagues)
                                                {
                                                    tt += "<div>" + ul.DisplayTitle + "<div>";
                                                }
                                                var tipTt3 = ViewContext.HttpContext.NextTooltipId();
                                                <span class="bm-tooltip-wrap">
                                                <span class="badge bg-success bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipTt3">
                                                    @dp.OwnedInUserLeagues.Count
                                                </span>
                                                <div class="bm-tooltip-content" id="@tipTt3" role="tooltip">@Html.Raw(tt)</div>
                                                </span>
                                            }
                                        </td>
                                        <td class="ps-1 pe-1">
                                            @if (dp.AvailableInUserLeagues != null && dp.AvailableInUserLeagues.Count > 0)
                                            {
                                                var tt = "<div>Available:</div>";
                                                foreach (var ul in dp.AvailableInUserLeagues)
                                                {
                                                    tt += "<div>" + ul.DisplayTitle + "<div>";
                                                }
                                                var tipTt4 = ViewContext.HttpContext.NextTooltipId();
                                                <span class="bm-tooltip-wrap">
                                                <span class="badge bg-info bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipTt4">
                                                    @dp.AvailableInUserLeagues.Count
                                                </span>
                                                <div class="bm-tooltip-content" id="@tipTt4" role="tooltip">@Html.Raw(tt)</div>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="col-auto p-2 rm-front-side rm-front-side--inj">
            @if (Model.InjuryDisplayPlayers != null && Model.InjuryDisplayPlayers.Count > 0)
            {
                <div class="card mb-3 border-danger bg rm-inj">
                    <div class="card-header text-nowrap">
                        <div class="rm-sb-header"><a class="rm-sb-title" asp-page="/Injuries">@Model.Sport.Title Recent Injuries</a><span class="rm-sb-count">@Model.InjuryDisplayPlayers.Count recent &middot; <a class="rm-inj-all" asp-page="/Injuries">All injuries &rsaquo;</a></span></div>
                    </div>
                    <div id="RecentInjuries">
                        <div class="card-body p-2">
                            <table class="table table-sm small rm-front-list">
                                <tr class="rm-inj-head">
                                    <td class="rm-inj-head-player">Player</td>
                                    <td class="tdr" title="% of leagues where he's rostered">Own%</td>
                                    <td class="tdr" title="% of leagues where he's started">Start%</td>
                                </tr>
                                @{
                                    var injOwnedIds = new HashSet<int>(Model.OwnedGameUserLeagueTeamPlayers.Select(gp => gp.UserLeagueTeamPlayer.PlayerId));
                                    var injSorted = Model.InjuryDisplayPlayers
                                        .OrderByDescending(x => x.IsMyPlayer)
                                        .ThenByDescending(x => x.OwnershipPlayer != null ? x.OwnershipPlayer.OwnershipPercent : 0)
                                        .ToList();
                                    int injIndex = 0;
                                }
                                @foreach (var dp in injSorted)
                                {
                                    <tr class="@(injIndex++ >= 10 ? "rm-inj-more" : "")">
                                        <td class="ps-1 pe-1">
                                            <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp}" />
                                        <span class="rm-inj-own own-cell text-white"><partial name="_DisplayPlayerOwn" model="dp" /></span>
                                        </td>

                                        @if (dp.OwnershipPlayer != null)
                                        {
                                            var ownTip = ViewContext.HttpContext.NextTooltipId();
                                            var actTip = ViewContext.HttpContext.NextTooltipId();
                                            <td class="tdr text-nowrap rm-badge-cell"><span class="bm-tooltip-wrap"><span class="rm-badge rm-inj-pct bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@ownTip" style="background-color:#@colorLib.OwnershipGetPercentColor(dp.OwnershipPlayer.OwnershipPercent)">@String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)</span><div class="bm-tooltip-content" id="@ownTip" role="tooltip">Rostered in @String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)% of leagues</div></span></td>
                                            <td class="tdr text-nowrap rm-badge-cell"><span class="bm-tooltip-wrap"><span class="rm-badge rm-inj-pct bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@actTip" style="background-color:#@colorLib.ActiveGetPercentColor(dp.OwnershipPlayer.ActivePercent)">@String.Format("{0:##0}", dp.OwnershipPlayer.ActivePercent)</span><div class="bm-tooltip-content" id="@actTip" role="tooltip">Started in @String.Format("{0:##0}", dp.OwnershipPlayer.ActivePercent)% of leagues</div></span></td>
                                        }
                                        else
                                        {
                                            <td colspan="2" />
                                        }
                                    </tr>
                                }
                            </table>
                            @if (Model.InjuryDisplayPlayers.Count > 10)
                            {
                                <button type="button" class="rm-inj-toggle" data-all="Show all @Model.InjuryDisplayPlayers.Count" onclick="var c=this.closest('.rm-inj');var on=c.classList.toggle('rm-inj--all');this.textContent=on?'Show top 10':this.dataset.all;">Show all @Model.InjuryDisplayPlayers.Count</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col p-2 rm-league-grid" id="rmLeagueGrid">
            @if (Model.UserLeagueViews.Count == 0)
            {
                <div class="rm-front-empty">
                    <div class="rm-front-empty-icon">+</div>
                    <h2 class="rm-front-empty-title">Add your first league</h2>
                    <p class="rm-front-empty-text">Import your fantasy leagues to see your rosters, today's games and MonsterBot recommendations here.</p>
                    <a class="btn btn-primary" asp-page="./UserLeagues/Import">Add Leagues</a>
                </div>
            }
            @foreach (var ulv in Model.UserLeagueViews)
            {
                <div class="card mb-3 bg" id="league-card-@ulv.UserLeague.Id" style="border-color:#@ViewData["LogoColor"];">

                    <div class="card-header text-nowrap">
                        <div class="small clearfix">
                            <div class="float-start">
                                <a href="@ulv.UserLeague.ProviderURL" target="_blank">@ulv.UserLeague.FantasyProvider.Name @ulv.UserLeague.ProviderLeagueId</a>
                            </div>
                            <div class="float-end ms-2">
                                <a asp-page="./UserLeagues/Edit" asp-route-id="@ulv.UserLeague.Id" alt="Edit Settings" title="Edit Settings">@Html.Raw(new Icon(new IconInput { Type = IconType.Settings, Size = 16 }).Render())</a>
                                <a class="ms-2" data-rm-live="league-card-@ulv.UserLeague.Id" asp-page-handler="UpdateRosters" asp-route-id="@ulv.UserLeague.Id" alt="Refresh Rosters" title="Refresh Rosters">@Html.Raw(new Icon(new IconInput { Type = IconType.RefreshRosters, Size = 16 }).Render())</a>
                            </div>
                        </div>

                        <h4 class="p-0 m-0 mt-1">
                            @ulv.UserLeague.DisplayTitle
                        </h4>

                        <h4 class="p-0 m-0 mt-1">
                            <a asp-page="./PlayerRankings"
                               asp-route-l="@ulv.UserLeague.Id"
                               asp-route-t="-1">@ulv.UserLeague.MyUserLeagueTeamTitle</a>
                        </h4>

                    </div>

                    <div class="card-body p-2">

                        @if (ulv.PlayerStatusDisplayPlayers.Count > 0)
                        {
                            <table class="table table-sm small table-bordered w-auto">
                                <tbody>
                                    @foreach (var dp in ulv.PlayerStatusDisplayPlayers)
                                    {
                                        <tr>
                                            <td class="tdc text-center text-nowrap text-white pe-1 @colorLib.GetDisplayPlayerOwnCss(dp)" style="min-width:40px;">
                                                <partial name="_DisplayPlayerOwn" model="dp" />
                                            </td>

                                            <td class="pe-1 ps-1">
                                                <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp,SelectedUserLeague=ulv.UserLeague}" />
                                            </td>

                                            @if (dp.OwnershipPlayer != null)
                                            {
                                                <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipGetPercentColor(dp.OwnershipPlayer.OwnershipPercent)">
                                                    @String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)
                                                    @if (dp.OwnershipPlayer.PercentOwnershipChange != 0)
                                                    {
                                                        <small class="rm-badge-change" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.OwnershipPlayer.PercentOwnershipChange)">@String.Format("{0:+##0;-##0;0}", dp.OwnershipPlayer.PercentOwnershipChange)</small>
                                                    }
                                                </span></td>

                                                <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.ActiveGetPercentColor(dp.OwnershipPlayer.ActivePercent)">
                                                    @String.Format("{0:##0}", dp.OwnershipPlayer.ActivePercent)
                                                    @if (dp.OwnershipPlayer.PercentActiveChange != 0)
                                                    {
                                                        <small class="rm-badge-change" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.OwnershipPlayer.PercentActiveChange)">@String.Format("{0:+##0;-##0;0}", dp.OwnershipPlayer.PercentActiveChange)</small>
                                                    }
                                                </span></td>
                                            }
                                            else
                                            {
                                                <td />
                                                <td />
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (ulv.DayDisplayPlayers.Count > 0)
                        {
                            <table class="table table-sm small table-bordered w-auto mt-2">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Own</th>
                                        <th class="tdc"><partial name="_DayOfWeek" model="ulv.Yesterday" /></th>
                                        <th>Game</th>
                                        <th>Player</th>
                                        <th class="tdc">
                                            @{ var tipMb = ViewContext.HttpContext.NextTooltipId(); }
                                            <span class="bm-tooltip-wrap">
                                            <span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="@tipMb">
                                                @ulv.MonsterBar.ColumnTitle(false)
                                            </span>
                                            <div class="bm-tooltip-content" id="@tipMb" role="tooltip">@ulv.MonsterBar.Tooltip</div>
                                            </span>
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var dp in ulv.DayDisplayPlayers)
                                    {
                                        <tr>
                                            <td class="tdc text-center text-nowrap text-white pe-1 @colorLib.GetDisplayPlayerOwnCss(dp)" style="min-width:40px;">
                                                <partial name="_DisplayPlayerOwn" model="dp" />
                                            </td>

                                            @if (dp.OwnershipPlayer != null)
                                            {
                                                <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipGetPercentColor(dp.OwnershipPlayer.OwnershipPercent)">
                                                    @String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)
                                                </span></td>
                                            }
                                            else
                                            {
                                                <td />
                                            }

                                            <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@dp.ValuePlayer.LeagueValueColor;">
                                                <partial name="_DisplayValuePlayer" model="new RotoMonster.Models.Shared.ValuePlayerModel() {ValuePlayer=dp.ValuePlayer,ShowMPG=true}" />
                                            </span></td>

                                            @if (dp.Game != null)
                                            {
                                                <td class="tdc">
                                                    <partial name="_GameState" model="new RotoMonster.Models.Shared.GameStateViewModel() {ShowCompact=true,Game=dp.Game,Sport=Model.Sport,Team=dp.SeasonPlayer.Team}" />
                                                </td>
                                            }
                                            else
                                            {
                                                <td />
                                            }

                                            <td class="pe-1 ps-1">
                                                <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp,SelectedUserLeague=ulv.UserLeague}" />
                                            </td>

                                            <td class="text-nowrap flex-nowrap">
                                                <partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarGamePlayer, ulv.MonsterBar.MonsterBarItems)" />
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (ulv.UserLeagueTeamAnalysis != null && ulv.UserLeagueTeamAnalysis.UserLeagueTeamAnalysisPlayerTypes.Count > 0)
                        {
                            <div class="mt-2">
                                <div class="mb-1">
                                    <partial name="_IconMonsterBot" /> MonsterBot Rating
                                </div>
                                @foreach (var analysisPlayerType in ulv.UserLeagueTeamAnalysis.UserLeagueTeamAnalysisPlayerTypes)
                                {
                                    <div class="small ps-1">
                                        @{ var tipOwn = ViewContext.HttpContext.NextTooltipId(); }
                                        <span class="bm-tooltip-wrap">
                                        <span class="me-1 bm-tooltip-trigger bm-tooltip-trigger--hover rm-badge rm-badge--inline" data-bm-tooltip="@tipOwn" style="background-color:#@colorLib.OwnershipGetPercentColor(analysisPlayerType.AverageOwnershipPercent)">
                                            @String.Format("{0:##0}% avg own", analysisPlayerType.AverageOwnershipPercent)
                                        </span>
                                        <div class="bm-tooltip-content" id="@tipOwn" role="tooltip">Average ownership %</div>
                                        </span>
                                        @{ var tipAct = ViewContext.HttpContext.NextTooltipId(); }
                                        <span class="bm-tooltip-wrap">
                                        <span class="me-1 bm-tooltip-trigger bm-tooltip-trigger--hover rm-badge rm-badge--inline" data-bm-tooltip="@tipAct" style="background-color:#@colorLib.ActiveGetPercentColor(analysisPlayerType.AverageActivePercent)">
                                            @String.Format("{0:##0}% avg start", analysisPlayerType.AverageActivePercent)
                                        </span>
                                        <div class="bm-tooltip-content" id="@tipAct" role="tooltip">Average start %</div>
                                        </span>
                                        @analysisPlayerType.PlayerType.DisplayTitle
                                    </div>
                                }
                            </div>
                        }

                        @if (ulv.MonsterBotPlayers != null && ulv.MonsterBotPlayers.Count > 0)
                        {
                            <div class="mt-2 alert alert-light border-danger small mb-0">
                                <partial name="_MonsterBotIcon" />
                                MonsterBot Recommendations
                                @foreach (var mbp in ulv.MonsterBotPlayers)
                                {
                                    <div class="ms-2">
                                        <partial name="_MonsterBotPlayer" model="mbp" />
                                        <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=mbp.DisplayPlayer,SelectedUserLeague=ulv.UserLeague}" />
                                    </div>
                                }
                            </div>
                        }

                        @if (ulv.FreeAgentDisplayPlayers.Count > 0)
                        {
                            <div class="mt-2"><partial name="_MonsterBotIcon" /> MonsterBot Top Free Agents</div>
                            <table class="table table-sm small table-bordered w-auto mt-1">
                                <tbody>
                                    @foreach (var dp in ulv.FreeAgentDisplayPlayers)
                                    {
                                        <tr>

                                            <td class="pe-1 ps-1">
                                                <partial name="_PlayerLinkExtra" model="new RotoMonster.Models.Shared.PlayerLinkModel() {DisplayPlayer=dp,SelectedUserLeague=ulv.UserLeague}" />
                                            </td>

                                            <td class="tdc text-nowrap">
                                                @if (dp.DepthPlayer != null && dp.DepthPlayer.Position != null)
                                                {
                                                    <small><partial name="_ColoredPosition" model="dp.DepthPlayer.Position" /></small>
                                                    @dp.DepthPlayer.Depth
                                                }
                                                <partial name="_HigherDepthInjuredDisplayPlayers" model="dp.HigherDepthInjuredDisplayPlayers" />
                                            </td>

                                            @if (dp.OwnershipPlayer != null)
                                            {
                                                <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.OwnershipGetPercentColor(dp.OwnershipPlayer.OwnershipPercent)">
                                                    @String.Format("{0:##0}", dp.OwnershipPlayer.OwnershipPercent)
                                                    @if (dp.OwnershipPlayer.PercentOwnershipChange != 0)
                                                    {
                                                        <small class="rm-badge-change" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.OwnershipPlayer.PercentOwnershipChange)">@String.Format("{0:+##0;-##0;0}", dp.OwnershipPlayer.PercentOwnershipChange)</small>
                                                    }
                                                </span></td>

                                                @if (Model.Sport.IsNFL)
                                                {

                                                    <td class="tdr text-nowrap rm-badge-cell"><span class="rm-badge" style="background-color:#@colorLib.ActiveGetPercentColor(dp.OwnershipPlayer.ActivePercent)">
                                                        @String.Format("{0:##0}", dp.OwnershipPlayer.ActivePercent)
                                                        @if (dp.OwnershipPlayer.PercentActiveChange != 0)
                                                        {
                                                            <small class="rm-badge-change" style="background-color:#@colorLib.OwnershipPercentChangeColor(dp.OwnershipPlayer.PercentActiveChange)">@String.Format("{0:+##0;-##0;0}", dp.OwnershipPlayer.PercentActiveChange)</small>
                                                        }
                                                    </span></td>
                                                }
                                            }
                                            else
                                            {
                                                <td />
                                                @if (Model.Sport.IsNFL)
                                                {
                                                    <td />
                                                }
                                            }

                                            <td class="text-nowrap flex-nowrap">
                                                <partial name="_MonsterBarBadge" model="RotoMonster.Models.Shared.MonsterBarBadgeViewModel.From(dp.MonsterBarGamePlayer, ulv.MonsterBar.MonsterBarItems)" />
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @*drops, adds, lineup changes, injuries*@
                    </div>
                </div>
            }

        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var sbDate = '';
            function updateContent() {
                $('#FrontGameScoresContainer .rm-sb-list').addClass('is-loading');
                $.ajax({
                    url: '@Url.Page("/Index", "FrontGameScores")' + (sbDate ? '&date=' + sbDate : ''),
                    type: 'GET',
                    success: function (data) {
                        $('#FrontGameScoresContainer').html(data);
                    },
                    error: function (xhr, status, error) {
                        console.error('FrontGameScores failed', xhr.status, error);
                        $('#FrontGameScoresContainer').html('Error loading data');
                    }
                });
            }

            $('#FrontGameScoresContainer').on('click', '[data-sb-date]', function () {
                sbDate = $(this).attr('data-sb-date');
                updateContent();
            });

            // Initial load
            updateContent();

            // Update every 60 seconds
            setInterval(updateContent, 60000);
        });
    </script>
}
