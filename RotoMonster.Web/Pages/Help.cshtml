@page
@model RotoMonster.Pages.HelpModel
@{
    ViewData["Title"] = "Help";
}

<div class="container-fluid px-4 rm-help">
    @Html.Raw(Model.HelpHtml)
</div>

@section Scripts {
<script>
document.querySelectorAll('.rm-help [data-toggle="collapse"]').forEach(function (btn) {
    btn.setAttribute('data-bs-toggle', 'collapse');
    btn.setAttribute('data-bs-target', btn.getAttribute('data-target'));
});
</script>
}
