@page
@model RotoMonster.Pages.PlayerRankingsModel
@{
    ViewData["Title"] = "Rankings";
    bool isUser = (Model.UserId != null);
    RotoMonster.Core.Libs.ColorLib colorLib = new Core.Libs.ColorLib();
}

<div class="ms-1 container rm-rankings">
    <div>
        @Html.Raw(new PageGuide("rankings-guide")
    .WithTitle("Player Rankings")
    .WithPurpose("This page ranks every player by how much value they have produced, so you can compare your roster against what is available and decide who to start, add or drop.")
    .AddSection("Total value vs per game value", "<p>The table sorts by <strong>TotalV</strong> by default, which is the value a player has produced across the whole date range. Click <strong>GameV</strong> to sort by value per game instead.</p><p>Total value rewards players who have stayed healthy and played often. Per game value shows who is most productive when they do play, which is the better view when you are deciding between two players for a single day.</p>")
    .AddSection("Narrowing the list", "<p>Use <strong>Value Settings</strong> at the top to switch between all players, only your team, or free agents. The <strong>Positions</strong> row filters to a single position.</p><p>The <strong>Date Range</strong> buttons change the window the values are calculated over. A short window shows who is hot right now, a full season shows who has been reliable.</p>")
    .AddSection("Ownership columns", "<p><strong>Own%</strong> is the percent of leagues where a player is rostered, and <strong>Act%</strong> is the percent where they are actively started.</p><p>A player with high ownership but low active percent is being held rather than used, which can be a signal they are droppable in your league too.</p>")
    .AddSection("Changing which columns show", "<p>The <strong>display options</strong> link below the buttons opens Display Settings, where you can pick exactly which stat and value columns appear in this table.</p>")
    .WithTourId("rankings-tour")
    .Render())

@Html.Raw(new Tour("rankings-tour")
    .WithManualTrigger()
    .AddStep("rm-tour-settings", "Start here. Show Settings opens the controls that decide what the rankings are based on, including the date range and which positions to include.", TooltipPosition.Bottom)
    .AddStep("rm-tour-myteam", "My Team narrows the list to only the players on your roster.", TooltipPosition.Top)
    .AddStep("rm-tour-freeagents", "Find Free Agents switches to your players plus everyone available in your league, sorted by advanced ownership percent, so the best pickups rise to the top.", TooltipPosition.Top)
    .AddStep("rm-tour-display", "Display options lets you choose exactly which stat and value columns show in the table.", TooltipPosition.Top)
    .Render())

        <a id="rm-tour-settings" class="rm-toggle-link" href="#ShowSettings" data-bs-toggle="collapse">Show Settings</a>
        @if (Model.UserLeagueTeamAnalyses != null)
        {
            <a class="ms-3 rm-toggle-link" href="#ShowAnalysis" data-bs-toggle="collapse">Show Team Ownership Analysis</a>
        }
    </div>

    <div id="ShowSettings" class="collapse">
        @if (Model.PlayerTableModel.SelectedUserLeague != null)
        {
                var leagueSettings = new RotoMonsterUI.LeagueSettingsInput
                {
                    ScoringType = Model.PlayerTableModel.SelectedUserLeague.LeagueType == "H"
                        ? RotoMonsterUI.LeagueScoringType.H2H
                        : RotoMonsterUI.LeagueScoringType.Roto,
                    NumTeams = Model.PlayerTableModel.SelectedUserLeague.NumberOfTeams,
                    PlayersPerTeam = Model.PlayerTableModel.SelectedUserLeague.PlayersPerTeam
                };

                if (Model.PlayerTableModel.CategorySettings != null)
                {
                    foreach (var cs in Model.PlayerTableModel.CategorySettings)
                    {
                        if (cs.Category == null) continue;

                        leagueSettings.Categories.Add(new RotoMonsterUI.LeagueSettingsCategory
                        {
                            Abbreviation = cs.Category.Abbreviation,
                            IsActive = cs.IsActive,
                            PointsPerStat = cs.PointsPerStat
                        });
                    }
                }
            @Html.Raw(new RotoMonsterUI.LeagueSettings(leagueSettings).Render())
        }
    </div>

    <div id="ShowAnalysis" class="collapse">
        @if (Model.UserLeagueTeamAnalyses != null)
        {
            <div class="rm-oa">
                <h5 class="rm-oa-title">Team Ownership Analysis</h5>
                <div class="rm-oa-scroll">
                    <table class="table rm-oa-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="rm-oa-team">Team</th>
                                <th>Avg</th>
                                @foreach (var pt in Model.ShowPlayerTypes)
                                {
                                    <th>@pt.DisplayTitle</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int num = 1;
                                foreach (var userLeagueTeamAnalysis in Model.UserLeagueTeamAnalyses)
                                {
                                    <tr>
                                        <td class="rm-oa-num">@num</td>
                                        <td class="rm-oa-team">@userLeagueTeamAnalysis.UserLeagueTeam.Title</td>
                                        <td>
                                            @if (userLeagueTeamAnalysis.UserLeagueTeamAnalysisPlayerTypes.Sum(p => p.PlayerCount) > 0)
                                            {
                                                <span class="rm-oa-chip" style="background-color:#@colorLib.OwnershipGetPercentColor(userLeagueTeamAnalysis.AverageOwnershipPercent)">@String.Format("{0:##0.0}%", userLeagueTeamAnalysis.AverageOwnershipPercent)</span>
                                            }
                                            else
                                            {
                                                <span class="rm-oa-none">&ndash;</span>
                                            }
                                        </td>
                                        @foreach (var ptAnalysis in userLeagueTeamAnalysis.UserLeagueTeamAnalysisPlayerTypes)
                                        {
                                            <td title="@ptAnalysis.PlayerCount @(ptAnalysis.PlayerCount == 1 ? "player" : "players")">
                                                @if (ptAnalysis.PlayerCount > 0)
                                                {
                                                    <span class="rm-oa-chip" style="background-color:#@colorLib.OwnershipGetPercentColor(ptAnalysis.AverageOwnershipPercent)">@String.Format("{0:##0.0}%", ptAnalysis.AverageOwnershipPercent)</span>
                                                    <span class="rm-oa-count">@ptAnalysis.PlayerCount</span>
                                                }
                                                else
                                                {
                                                    <span class="rm-oa-none">&ndash;</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                    num++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <form method="post" id="rankingsForm" class="rm-live-section" data-rm-live>
        <input asp-for="DefaultSort" type="hidden" />

        <div class="modern-filter-container">

        <div class="rm-filter-section modern-filter-row" data-title="Value settings">
            <input type="hidden" asp-for="@Model.SelectedUserLeagueId" />
            <select asp-for="@Model.SelectedFilterId" class="form-control rm-modern-select rm-modern-select-wide" asp-items="ViewBag.FilterList" onchange="this.form.requestSubmit()"></select>
            <select asp-for="@Model.SelectedPerValueId" class="form-control rm-modern-select" asp-items="ViewBag.PerValues" onchange="this.form.requestSubmit()"></select>
            <select asp-for="@Model.SelectedTeamId" class="form-control rm-modern-select" asp-items="ViewBag.TeamList" onchange="this.form.requestSubmit()"></select>
        </div>

        <div class="rm-filter-section modern-filter-row" data-title="Date range">
            <input type="date" asp-for="@Model.SelectedStartDate" class="form-control rm-date-input" />
            <input type="date" asp-for="@Model.SelectedEndDate" class="form-control rm-date-input" />
            <input type="submit" name="seasonbutton" value="Season" class="btn btn-sm btn-outline-dark" />
            <input type="submit" name="onemonthbutton" value="1 Month" class="btn btn-sm btn-outline-dark" />
            <input type="submit" name="twoweeksbutton" value="2 Weeks" class="btn btn-sm btn-outline-dark" />
            <input type="submit" name="oneweekbutton" value="1 Week" class="btn btn-sm btn-outline-dark" />
            <input type="submit" name="onedaybutton" value="1 Day" class="btn btn-sm btn-outline-dark" />
        </div>

        <div class="rm-filter-section modern-filter-row rm-pos-filter" data-title="Positions">
            @foreach (var playerType in Model.ShowPlayerTypes)
            {
                <div class="rm-pos-group">
                    @foreach (var ars in Model.DisplayActiveRosterSpots)
                    {
                        if (ars.PlayerType.Id == playerType.Id)
                        {
                            <label class="rm-pos-badge text-nowrap">
                                <input asp-for="SelectedDisplayActiveRosterSpotId" value="@ars.Id" type="radio" onchange="this.form.requestSubmit()" />
                                <span class="rm-pos-badge-label">
                                    @foreach (var p in ars.Positions)
                                    {
                                        <partial name="_ColoredPosition" model="@p" />
                                    }
                                </span>
                            </label>
                        }
                    }
                </div>
            }
        </div>

        <div class="rm-filter-section modern-filter-row" data-title="Display">
            <span>
                <div class="form-check form-switch rm-switch">
                    <input asp-for="ColorStats" class="form-check-input" role="switch" onchange="this.form.requestSubmit()">
                    <label class="form-check-label" asp-for="ColorStats"></label>
                </div>
            </span>

            <span class="ms-2">
                <div class="form-check form-switch rm-switch">
                    <input asp-for="IncludeLive" class="form-check-input" role="switch" onchange="this.form.requestSubmit()">
                    <label class="form-check-label" asp-for="IncludeLive"></label>
                </div>
            </span>

            @if (isUser)
            {
                <span class="ms-2">
                    <div class="form-check form-switch rm-switch">
                        <input asp-for="ShowDraft" class="form-check-input" role="switch" onchange="this.form.requestSubmit()">
                        <label class="form-check-label" asp-for="ShowDraft"></label>
                    </div>
                </span>

                <span class="ms-2">
                    [Own# @Model.OwnershipLeagueCount]
                </span>
            }
        </div>

        @if (Model.PlayerTableModel.ShowAnalysisDates)
        {
            <div id="AnalysisDates" class="rm-filter-section modern-filter-row" data-title="Projections">
                <div class="col-">
                    <input type="date" asp-for="@Model.AnalysisStartDate" />
                    <input type="date" asp-for="@Model.AnalysisEndDate" />
                    <input type="submit" name="analysis1week" value="Current Week" class="btn btn-sm btn-primary" />
                    <input type="submit" name="analysisnextweek" value="Next Week" class="btn btn-sm btn-primary" />
                    <input type="submit" name="analysis2weeks" value="Two Weeks" class="btn btn-sm btn-primary" />
                </div>
                <div class="col-auto ms-2">
                    <select asp-for="@Model.SelectedProjectionSourceId" class="form-control rm-modern-select rm-modern-select-wide" asp-items="ViewBag.ProjectionSourceList"></select>
                </div>
            </div>
        }

        <div class="rm-filter-section modern-filter-row">
            <button class="btn btn-primary">Refresh</button>
            <input type="submit" name="topplayersbutton" value="Top Players" class="btn btn-sm btn-outline-dark" />
            @if (isUser)
            {
                <input id="rm-tour-myteam" type="submit" name="myteambutton" value="My Team" class="btn btn-sm btn-outline-dark" />
                <input id="rm-tour-freeagents" type="submit" name="freeagentsbutton" value="Find Free Agents" class="btn btn-sm btn-outline-dark" />
                <input type="submit" name="waiversbutton" value="Waiver Trends" class="btn btn-sm btn-outline-dark" />
                <input type="submit" name="livebutton" value="Live Results" class="btn btn-sm btn-outline-dark" />
                <button type="submit" name="rostersbutton" value="Refresh Rosters" class="btn btn-sm btn-outline-dark">@Html.Raw(new Icon(new IconInput { Type = IconType.RefreshRosters, Size = 16 }).Render())<span class="ms-1">Refresh Rosters</span></button>
                <input type="submit" name="depthbutton" value="Depth" class="btn btn-sm btn-outline-dark" />
                <input type="submit" name="draftmodebutton" value="Draft Mode" class="btn btn-sm btn-outline-dark" />
            }

            <span class="ms-2">
                <a id="rm-tour-display" asp-page="./DisplaySettings">display options</a>
            </span>
        </div>

        </div>

        @if (Model.ButtonMessage.Length > 0)
        {
            <div class="alert alert-info">@Model.ButtonMessage</div>
        }

        @if (Model.ShowDraft)
        {
            <div class="row m-1 mt-0 mb-2 p-1 pt-2 border border-secondary">
                <div class="col-auto ps-2">
                    <label asp-for="ProviderDraftId"></label>
                    <input asp-for="ProviderDraftId">
                </div>
                @if (Model.DraftedCount > 0)
                {
                    <div class="col-auto ps-3 pe-3 mt-1">
                        <label asp-for="DraftedCount"></label>: @Model.DraftedCount
                    </div>
                }

                @if (ViewBag.DraftTeamList != null)
                {
                    <div class="col-auto ps-3">
                        <select asp-for="@Model.SelectedDraftTeamId" class="form-control rm-modern-select" asp-items="ViewBag.DraftTeamList"></select>
                    </div>
                }
                @if (Model.UpcomingDraftText.Length > 0)
                {
                    <div class="col-auto ps-3 pe-3 mt-1">
                        @Model.UpcomingDraftText
                    </div>
                }

                <div class="col-auto ps-3 pe-3 mt-1">
                    <div class="form-check form-switch rm-switch">
                        <input asp-for="HideDrafted" class="form-check-input" role="switch">
                        <label class="form-check-label" asp-for="HideDrafted"></label>
                    </div>
                </div>

                <div class="col-auto ps-2">
                    <label asp-for="AnalysisAdpLeagueCount"></label>
                    <input asp-for="AnalysisAdpLeagueCount">
                </div>

                <div class="col-auto ps-3 pe-3 mt-1">
                    [ADP# @Model.AdpLeagueCount]
                </div>

                @if (Model.PickList.Count() > 0)
                {
                    <div class="col-auto ps-3 pe-3 mt-1">
                        @foreach (int pick in Model.PickList)
                        {
                            if (pick <= Model.DraftedCount)
                            {
                                <span class="ms-1 fw-bold">@pick</span>
                            }
                            else
                            {
                                <span class="ms-1">@pick</span>
                            }
                        }
                    </div>
                }

                @if (Model.ProviderDraftId != null)
                {
                    <div class="col-auto ps-3 pe-3 mt-1">
                        <input type="submit" name="refreshdraft" value="Refresh Draft Results" class="btn btn-sm btn-secondary" />
                    </div>
                }

            </div>
        }

        <partial name="_PlayerTable" model="Model.PlayerTableModel" />
    </form>
</div>

@section scripts{
    <script>
        (function () {
            function currentSort() {
                var input = document.querySelector('#rankingsForm input[name="DefaultSort"]');
                return input ? (input.value || '').toUpperCase() : '';
            }

            function setupHeaders() {
                var sorted = currentSort();
                document.querySelectorAll('#rankingsForm thead button[formaction*="sort="]').forEach(function (btn) {
                    btn.classList.add('rm-th-sort');
                    var m = /[?&]sort=([^&#]+)/i.exec(btn.getAttribute('formaction') || '');
                    btn.classList.toggle('rm-th-sorted', !!(m && sorted && decodeURIComponent(m[1]).toUpperCase() === sorted));
                });
            }

            setupHeaders();
            document.addEventListener('rm:live-updated', setupHeaders);
        })();
    </script>
}
