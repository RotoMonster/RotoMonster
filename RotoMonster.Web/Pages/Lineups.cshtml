@page
@model RotoMonster.Pages.LineupsModel
@{
    int leagueId = Model.SelectedUserLeagueId;
    bool anyBench = Model.Games.Any(g => g.Teams.Any(t => t.Bench.Count > 0));
}

<div class="container-fluid px-4 rm-lu rm-lu--@Model.SportKey">

    <form method="post" class="rm-lu-toolbar">
        <input type="hidden" asp-for="@Model.SelectedUserLeagueId" />
        <h1 class="rm-lu-title">@Model.Sport.Title Lineups</h1>
        <div class="rm-lu-datenav">
            <button type="submit" name="backbutton" value="1" class="rm-lu-dn-btn" aria-label="Previous day">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div class="rm-lu-dn-date" id="luDateBtn" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" aria-label="Pick a date">
                <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                <span class="rm-lu-dn-text">@Model.SelectedDate.ToString("ddd, MMM d")</span>
                <input type="date" asp-for="@Model.SelectedDate" asp-format="{0:yyyy-MM-dd}" class="rm-lu-datebox" hidden />
            </div>
            <button type="submit" name="nextbutton" value="1" class="rm-lu-dn-btn" aria-label="Next day">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        </div>
        @{ var luToday = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, RotoMonster.Core.Game.DisplayZone).Date; }
        <div class="rm-lu-cal" id="luCal" data-today='@luToday.ToString("yyyy-MM-dd")' role="dialog" aria-label="Choose a date" hidden></div>
        <script src="~/js/rm-lineups-cal.js" asp-append-version="true" defer></script>
        @if (Model.SelectedDate.Date != luToday)
        {
            <a class="rm-lu-today" asp-page="./Lineups" asp-route-date='@luToday.ToString("yyyy-MM-dd")' asp-route-l="@Model.SelectedUserLeagueId">Today</a>
        }
        <span class="rm-lu-count">@(Model.IsWeek ? "Week of " + Model.RangeStart.ToString("MMM d") + " \u2013 " + Model.RangeEnd.ToString("MMM d") : Model.SelectedDate.ToString("dddd, MMM d")) &middot; @Model.Games.Count games</span>
        <div class="rm-lu-seg" role="group" aria-label="Filter games">
            <button type="button" data-lu-filter="all" aria-pressed="true">All games</button>
            <button type="button" data-lu-filter="upcoming" aria-pressed="false">Not started</button>
            @if (Model.IsLoggedIn)
            {
                <button type="button" data-lu-filter="mine" aria-pressed="false">My players</button>
            }
        </div>
        <select class="form-select form-select-sm rm-lu-find" id="luFind" aria-label="Jump to team">
            <option value="">All teams</option>
            @foreach (var ft in Model.Games.SelectMany(g => g.Teams).Select(t => t.Team).Where(t => t != null).GroupBy(t => t.Id).Select(g => g.First()).OrderBy(t => string.IsNullOrWhiteSpace(t.Name) ? t.Code : t.Name))
            {
                <option value="@((ft.Code ?? "").ToLowerInvariant())">@(string.IsNullOrWhiteSpace(ft.Name) ? ft.Code : ft.Name)</option>
            }
        </select>
        @if (anyBench)
        {
            <label class="rm-lu-switch"><input type="checkbox" id="luBenchAll" /> Show benches</label>
        }
    </form>

    <div class="rm-lu-legend">
        <span><i class="rm-lu-sw rm-lu-sw--ok"></i>Confirmed</span>
        <span><i class="rm-lu-sw rm-lu-sw--proj"></i>Projected</span>
        <span class="bm-tooltip-wrap"><span class="bm-tooltip-trigger bm-tooltip-trigger--hover" data-bm-tooltip="bm-tip-own-legend"><span class="rm-own-pair"><span class="rm-badge rm-badge--inline rm-own-pct" style="background-color:#a6ffff">Own</span><span class="rm-badge rm-badge--inline rm-own-pct" style="background-color:#ffe680">Act</span></span>% owned / active in leagues</span><div class="bm-tooltip-content" id="bm-tip-own-legend" role="tooltip">Own% is how many tracked leagues have the player on a roster. Act% is how many have him in an active lineup spot. Hover any badge for the exact number and its 24-hour change.</div></span>
        @if (Model.IsLoggedIn)
        {
            <span><span class="rm-lu-own">Own</span>active <span class="rm-lu-own rm-lu-own--bench">Own</span>benched</span>
        }
    </div>

    @if (Model.Games.Count == 0)
    {
        <div class="rm-lu-empty">@(Model.IsWeek ? "No games this week." : "No games on this date.")</div>
    }

    <div class="rm-lu-empty" id="luNoMatch" hidden>No games match.</div>

    <div class="rm-lu-grid">
        @for (int gi = 0; gi < Model.Games.Count; gi++)
        {
            var lg = Model.Games[gi];
            <article class="rm-lu-card" data-state="@lg.State" data-own="@(lg.HasOwned ? "1" : "0")" data-teams="@(" " + string.Join(" ", lg.Teams.Select(t => (t.Team.Code ?? "").ToLowerInvariant())) + " ")">
                <div class="rm-lu-chead">
                    <span class="rm-lu-status rm-lu-status--@lg.State">@lg.StatusText</span>
                    <span class="rm-lu-matchup">@lg.Game.GameText</span>
                    <span class="rm-lu-spacer"></span>
                    @if (lg.Game.HasStarted)
                    {
                        <a asp-page="/Scores" asp-route-g="@lg.Game.Id" asp-route-l="@leagueId">Box score</a>
                    }
                </div>

                <div class="rm-lu-pick" role="group" aria-label="Team">
                    @for (int ti = 0; ti < lg.Teams.Count; ti++)
                    {
                        <button type="button" data-lu-pick="@ti" aria-pressed="@(ti == 0 ? "true" : "false")" style="--tc:@lg.Teams[ti].Color">@lg.Teams[ti].Team.Code</button>
                    }
                </div>

                <div class="rm-lu-teams">
                    @for (int ti = 0; ti < lg.Teams.Count; ti++)
                    {
                        var lt = lg.Teams[ti];
                        <section class="rm-lu-team@(ti == 0 ? "" : " rm-lu-team--alt")" data-lu-team="@ti" style="--tc:@lt.Color">
                            <div class="rm-lu-thead">
                                <span class="rm-lu-tcode" title="@lt.Team.Code">@(string.IsNullOrWhiteSpace(lt.Team.Name) ? lt.Team.Code : lt.Team.Name)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(lt.Implied) || !string.IsNullOrEmpty(lt.Line))
                            {
                                <div class="rm-lu-odds">
                                    @if (!string.IsNullOrEmpty(lt.Implied))
                                    {
                                        <span class="rm-lu-implied">@lt.Implied</span>
                                    }
                                    @if (!string.IsNullOrEmpty(lt.Implied) && !string.IsNullOrEmpty(lt.Line))
                                    {
                                        <span>&middot;</span>
                                    }
                                    @lt.Line
                                </div>
                            }
                            <div class="rm-lu-ctx"><span class="rm-lu-ctx-slot">@lt.SlotHead</span><span class="rm-lu-ctx-main">@lt.Context</span><span>@lt.RightHead</span></div>

                            @{ var lineGroups = lt.Rows.Where(r => !string.IsNullOrEmpty(r.Group)).GroupBy(r => r.Group).ToList(); }
                            @foreach (var grp in lineGroups)
                            {
                                var isPair = Model.Sport.IsNHL && grp.Key.StartsWith("D");
                                var lineTag = Model.Sport.IsNHL ? (isPair ? "D" : "L") + grp.Key.Substring(grp.Key.Length - 1) : grp.Key;
                                <div class="rm-lu-line@(isPair ? " rm-lu-line--d" : "")">
                                    <div class="rm-lu-line-tag" title="@grp.Key">@lineTag</div>
                                    <div class="rm-lu-line-rows">
                                        @foreach (var r in grp)
                                        {
                                            <partial name="_LineupRow" model="new RotoMonster.Pages.LineupRowView { Row = r, IsMLB = Model.Sport.IsMLB, LeagueId = leagueId }" />
                                        }
                                    </div>
                                </div>
                            }
                            @foreach (var r in lt.Rows.Where(r => string.IsNullOrEmpty(r.Group)))
                            {
                                <partial name="_LineupRow" model="new RotoMonster.Pages.LineupRowView { Row = r, IsMLB = Model.Sport.IsMLB, LeagueId = leagueId }" />
                            }
                            @if (lt.Rows.Count == 0)
                            {
                                <div class="rm-lu-none">Not posted yet</div>
                            }

                            @if (lt.Bench.Count > 0)
                            {
                                <details class="rm-lu-bench">
                                    <summary>@lt.BenchTitle (@lt.Bench.Count)</summary>
                                    @foreach (var r in lt.Bench)
                                    {
                                        <partial name="_LineupRow" model="new RotoMonster.Pages.LineupRowView { Row = r, IsMLB = Model.Sport.IsMLB, LeagueId = leagueId, IsBench = true }" />
                                    }
                                </details>
                            }

                            <div class="rm-lu-foot rm-lu-foot--@lt.FooterKind">@lt.Footer</div>
                        </section>
                    }
                </div>
            </article>
        }
    </div>

    <div class="rm-lu-tz">@RotoMonster.Core.Game.DisplayZoneName &middot; <a asp-page="/DisplaySettings" asp-fragment="timezone">Change timezone</a></div>
</div>

@section Scripts {
<script>
(function () {
    var root = document.querySelector('.rm-lu');
    if (!root) return;
    var luMode = 'all';
    var find = document.getElementById('luFind');
    function luApply() {
        var q = find ? find.value : '';
        var shown = 0;
        root.querySelectorAll('.rm-lu-card').forEach(function (c) {
            var show = (luMode === 'all' || (luMode === 'upcoming' && c.dataset.state === 'upcoming') || (luMode === 'mine' && c.dataset.own === '1'))
                && (!q || (c.dataset.teams || '').indexOf(' ' + q + ' ') >= 0);
            c.hidden = !show;
            if (show) shown++;
        });
        if (find) find.classList.toggle('is-set', !!q);
        var none = document.getElementById('luNoMatch');
        if (none) none.hidden = shown > 0;
    }
    if (find) find.addEventListener('change', luApply);
    root.addEventListener('click', function (e) {
        var f = e.target.closest('[data-lu-filter]');
        if (f) {
            luMode = f.getAttribute('data-lu-filter');
            root.querySelectorAll('[data-lu-filter]').forEach(function (b) { b.setAttribute('aria-pressed', b === f ? 'true' : 'false'); });
            luApply();
            return;
        }
        var p = e.target.closest('[data-lu-pick]');
        if (p) {
            var card = p.closest('.rm-lu-card');
            var idx = p.getAttribute('data-lu-pick');
            card.querySelectorAll('[data-lu-pick]').forEach(function (b) { b.setAttribute('aria-pressed', b === p ? 'true' : 'false'); });
            card.querySelectorAll('[data-lu-team]').forEach(function (t) { t.classList.toggle('rm-lu-team--alt', t.getAttribute('data-lu-team') !== idx); });
        }
    });
    var all = document.getElementById('luBenchAll');
    if (all) {
        all.addEventListener('change', function () {
            root.querySelectorAll('.rm-lu-bench').forEach(function (d) { d.open = all.checked; });
        });
    }
})();
</script>
}
