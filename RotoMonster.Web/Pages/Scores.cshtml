@page
@model RotoMonster.Pages.ScoresModel
@{
    string sportKey = (Model.Sport != null ? Model.Sport.Title : "").Trim().ToLower();
    string periodPrefix = sportKey == "nhl" ? "P" : sportKey == "mlb" ? "Inn " : "Q";
    var selectedGame = Model.BoxScoreModel != null ? Model.BoxScoreModel.Game : null;

    string StateText(RotoMonster.Core.Game game)
    {
        if (game.IsPostponed == true) return "PPD";
        if (game.IsFinished) return "Final";
        if (game.HasStarted) return game.Period > 0 ? periodPrefix + game.Period + (string.IsNullOrEmpty(game.GameClock) ? "" : " " + game.GameClock) : "Live";
        return game.EasternTime.ToString("h:mm tt");
    }

    string StateCss(RotoMonster.Core.Game game)
    {
        if (game.IsPostponed == true) return "rm-sc-state--ppd";
        if (game.IsFinished) return "rm-sc-state--final";
        if (game.HasStarted) return "rm-sc-state--live";
        return "rm-sc-state--pre";
    }

    string TeamColor(RotoMonster.Core.Team team)
    {
        if (team == null) return "var(--brand-primary)";
        return "var(--team-" + sportKey + "-" + (team.Code ?? "").Trim().ToLower() + ", var(--brand-primary))";
    }

    string TeamName(RotoMonster.Core.Team team)
    {
        if (team == null) return "";
        return string.IsNullOrWhiteSpace(team.Name) ? team.Code : team.Name;
    }

    string ResultCss(RotoMonster.Core.Game game, RotoMonster.Core.Team team)
    {
        if (!game.IsFinished) return "";
        int mine = game.GetTeamScore(team);
        int theirs = game.GetOpponentTeamScore(team);
        return mine > theirs ? "rm-sc-team--won" : mine < theirs ? "rm-sc-team--lost" : "";
    }
}

<div class="container-fluid px-4">

    @Html.Raw(new PageGuide("scores-guide")
        .WithTitle("Box Scores")
        .WithPurpose("Scores shows every game on the selected day with live scores, and the box score for whichever game you pick.")
        .AddSection("The game list", "<p>Games on the left update on their own while they are live. Click any game to open its box score on the right.</p><p>When you are logged in, the <strong>yours</strong> pill shows how many of your players are in that game.</p>")
        .AddSection("Box score", "<p>The box score lists every player's stats for the game, so you can see exactly how your players did.</p>")
        .AddSection("Changing the date", "<p>Use the arrows to move a day at a time, or click the date to pick one from the calendar. <strong>Today</strong> brings you back to the current day, and <strong>Refresh</strong> pulls the latest scores.</p>")
        .WithTourId("scores-tour")
        .Render())

    @Html.Raw(new Tour("scores-tour")
        .WithManualTrigger()
        .AddStep("rm-tour-sc-list", "Every game for the day. Scores update on their own while games are live, and the yours pill shows how many of your players are in each game.", TooltipPosition.Right)
        .AddStep("luDateBtn", "Click the date to pick a different day from the calendar.", TooltipPosition.Bottom)
        .AddStep("rm-tour-sc-refresh", "Refresh pulls the latest scores right away.", TooltipPosition.Bottom)
        .AddStep("rm-tour-sc-box", "Click any game in the list to see its box score here.", TooltipPosition.Left)
        .Render())
    
    <form method="post" id="scoresForm" class="rm-live-section" data-rm-live>

        <input type="hidden" asp-for="@Model.SelectedUserLeagueId" />

        <div class="rm-sc">

            <aside class="rm-sc-side" id="rm-tour-sc-list">
                <div class="rm-sc-card">

                    <div class="rm-sc-nav">
                        <button type="submit" name="backbutton" value="Back" class="rm-sc-step" title="Previous day" aria-label="Previous day">&lsaquo;</button>
                        <div class="rm-sc-day">
                            <div class="rm-sc-dayname">@Model.SelectedDate.ToString("dddd")</div>
                            <div class="rm-sc-daysub">@Model.SelectedDate.ToString("MMM d") &middot; @Model.ScheduleGames.Count @(Model.ScheduleGames.Count == 1 ? "game" : "games")</div>
                        </div>
                        <button type="submit" name="nextbutton" value="Next" class="rm-sc-step" title="Next day" aria-label="Next day">&rsaquo;</button>
                    </div>

                    @{ var scToday = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, RotoMonster.Core.Game.DisplayZone).Date; }
                    <div class="rm-sc-tools">
                        <div class="rm-lu-datenav rm-sc-datenav">
                            <div class="rm-lu-dn-date" id="luDateBtn" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" aria-label="Pick a date">
                                <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                                <span class="rm-lu-dn-text">@Model.SelectedDate.ToString("ddd, MMM d")</span>
                                <input type="date" asp-for="@Model.SelectedDate" asp-format="{0:yyyy-MM-dd}" class="rm-lu-datebox" hidden />
                            </div>
                        </div>
                        @if (Model.SelectedDate.Date != scToday)
                        {
                            <a class="rm-lu-today" asp-page="./Scores" asp-route-date='@scToday.ToString("yyyy-MM-dd")' asp-route-l="@Model.SelectedUserLeagueId">Today</a>
                        }
                        <button class="rm-sc-refresh" id="rm-tour-sc-refresh" title="Refresh">Refresh</button>
                        <div class="rm-lu-cal" id="luCal" data-today='@scToday.ToString("yyyy-MM-dd")' role="dialog" aria-label="Choose a date" hidden></div>
                    </div>
                    <script src="~/js/rm-lineups-cal.js" asp-append-version="true" defer></script>

                    <label class="rm-sc-toggle">
                        <input asp-for="ShowTopToo" class="form-check-input" />
                        <span title="Also list top players on these teams who didn't play, like injured or scratched players">Include top players who sat out</span>
                    </label>

                    <div class="rm-sc-list">
                        @if (Model.ScheduleGames.Count == 0)
                        {
                            <div class="rm-sc-none">No games on this date.</div>
                        }
                        @foreach (var game in Model.ScheduleGames)
                        {
                            bool postponed = game.IsPostponed == true;
                            bool finished = game.IsFinished;
                            bool live = !finished && !postponed && game.HasStarted;
                            bool showScores = finished || live;
                            bool canView = game.PercentComplete > 0 || game.IsFinished;
                            bool isSelected = selectedGame != null && selectedGame.Id == game.Id;
                            bool anyProj = !showScores && (game.ProjectedPoints(Model.Sport, game.AwayTeam) > 0 || game.ProjectedPoints(Model.Sport, game.HomeTeam) > 0);
                            string stateCss = postponed ? "rm-sbc-game--ppd" : finished ? "rm-sbc-game--final" : live ? "rm-sbc-game--live" : "rm-sbc-game--pre";
                            string rowCss = "rm-sc-game rm-sbc-game " + stateCss + (isSelected ? " rm-sc-game--on" : "") + (canView ? "" : " rm-sc-game--off");
                            int[] mine = Model.MyGameCounts.TryGetValue(game.Id, out var mc) ? mc : null;

                            <button type="submit" name="viewgame" value="box score" asp-route-newgameid="@game.Id" class="@rowCss" title="@(canView ? "Box score" : "")" disabled="@(!canView)">
                                <span class="rm-sbc-teams">
                                    @foreach (var t in game.GetTeams())
                                    {
                                        if (t == null) { continue; }
                                        double proj = game.ProjectedPoints(Model.Sport, t);
                                        string result = finished ? ResultCss(game, t).Replace("rm-sc-", "rm-sbc-") : "";
                                        <span class="rm-sbc-team @result" style="--tc: @TeamColor(t);">
                                            <span class="rm-sbc-badge">@t.Code</span>
                                            <span class="rm-sbc-name" title="@TeamName(t)">@TeamName(t)</span>
                                            @if (showScores)
                                            {
                                                <span class="rm-sbc-score" style="@game.GetTeamStyle(t)">@game.GetTeamScore(t)</span>
                                            }
                                            else if (proj > 0)
                                            {
                                                <span class="rm-sbc-proj" title="Projected">@proj.ToString("0.0")</span>
                                            }
                                        </span>
                                    }
                                </span>
                                <span class="rm-sbc-side">
                                    @if (postponed)
                                    {
                                        <span class="rm-sbc-state rm-sbc-state--ppd">Postponed</span>
                                    }
                                    else if (live)
                                    {
                                        <span class="rm-sbc-state rm-sbc-state--live">@StateText(game)</span>
                                        <span class="rm-sbc-bar"><span style="width:@Math.Max(4, Math.Min(100, game.PercentComplete))%"></span></span>
                                    }
                                    else
                                    {
                                        <span class="rm-sbc-state">@(finished ? "Final" : game.EasternTime.ToString("ddd h:mm tt"))</span>
                                        @if (anyProj)
                                        {
                                            <span class="rm-sbc-sub">projected</span>
                                        }
                                    }
                                    @if (mine != null && mine[1] > 0)
                                    {
                                        <span class="rm-sc-mine" title="@mine[1] of your players are in this game (@mine[0] active)">@mine[1] yours</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>

                    <div class="rm-scores-tz">@RotoMonster.Core.Game.DisplayZoneName &middot; <a asp-page="/DisplaySettings" asp-fragment="timezone">Change timezone</a></div>
                </div>
            </aside>

            <div class="rm-sc-main" id="rm-tour-sc-box">

                @if (selectedGame != null)
                {
                    <input type="hidden" id="gameid" name="prevgameid" value="@selectedGame.Id" />

                    <div class="rm-sc-card rm-sc-head">
                        <span class="rm-sc-state rm-sc-head-state @StateCss(selectedGame)">@StateText(selectedGame)</span>
                        @foreach (var t in selectedGame.GetTeams())
                        {
                            <div class="rm-sc-head-team @ResultCss(selectedGame, t)" style="--tc: @TeamColor(t);">
                                <div class="rm-sc-head-id">
                                    <span class="rm-sc-head-code">@(t.Id == selectedGame.HomeTeam.Id ? "@" : "")@t.Code</span>
                                    <span class="rm-sc-head-name">@t.Name</span>
                                </div>
                                <span class="rm-sc-score rm-sc-head-score" style="@selectedGame.GetTeamStyle(t)">@selectedGame.GetTeamScore(t)</span>
                            </div>
                        }
                    </div>

                    @if (Model.Sport != null && Model.Sport.IsNFL)
                    {
                        <partial name="_NflBoxScore" model="Model" />
                    }
                    else
                    {
                    foreach (var team in selectedGame.GetTeams())
                    {
                        <section class="rm-sc-card rm-sc-box" style="--tc: @TeamColor(team);">
                            <header class="rm-sc-box-head">
                                <span class="rm-sc-score" style="@selectedGame.GetTeamStyle(team)">@selectedGame.GetTeamScore(team)</span>
                                <span class="rm-sc-head-code">@team.Code</span>
                                <span class="rm-sc-head-name">@team.Name</span>
                            </header>

                            @foreach (var playerType in Model.BoxScoreModel.PlayerTypes)
                            {
                                var playerTableModel = Model.BoxScoreModel.TeamPlayerTableModels[team][playerType];
                                if (playerTableModel.DisplayPlayers.Count > 0)
                                {
                                    var allPlayers = playerTableModel.DisplayPlayers;
                                    var typeTitle = string.IsNullOrEmpty(playerType.PluralTitle) ? playerType.Title : playerType.PluralTitle;
                                    var boxGroups = new List<KeyValuePair<string, List<RotoMonster.Core.DisplayPlayer>>>();
                                    var qbs = playerTableModel.Sport != null && playerTableModel.Sport.IsNFL
                                        ? allPlayers.Where(p => p.Positions != null && p.Positions.Any(x => x != null && x.Abbreviation == "QB")).ToList()
                                        : new List<RotoMonster.Core.DisplayPlayer>();
                                    if (qbs.Count > 0 && qbs.Count < allPlayers.Count)
                                    {
                                        boxGroups.Add(new KeyValuePair<string, List<RotoMonster.Core.DisplayPlayer>>("Quarterbacks", qbs));
                                        boxGroups.Add(new KeyValuePair<string, List<RotoMonster.Core.DisplayPlayer>>(typeTitle, allPlayers.Where(p => !qbs.Contains(p)).ToList()));
                                    }
                                    else
                                    {
                                        boxGroups.Add(new KeyValuePair<string, List<RotoMonster.Core.DisplayPlayer>>(typeTitle, allPlayers));
                                    }
                                    foreach (var boxGroup in boxGroups)
                                    {
                                        playerTableModel.DisplayPlayers = boxGroup.Value;
                                        if (Model.BoxScoreModel.PlayerTypes.Count > 1 || boxGroups.Count > 1)
                                        {
                                            <div class="rm-sc-box-type">@boxGroup.Key</div>
                                        }
                                        <div class="rm-scores-table">
                                            @await Html.PartialAsync("_PlayerTable", playerTableModel)
                                        </div>
                                    }
                                    playerTableModel.DisplayPlayers = allPlayers;
                                }
                            }
                        </section>
                    }
                    }

                    if (Model.BoxScoreModel.Articles != null && Model.BoxScoreModel.Articles.Count > 0)
                    {
                        foreach (var article in Model.BoxScoreModel.Articles)
                        {
                            <partial name="_Article" model="article" />
                        }
                    }
                }
                else
                {
                    <div class="rm-sc-empty">Pick a game to see its box score.</div>
                }

            </div>

        </div>

        <input type="hidden" id="prevdate" name="prevdate" value="@Model.SelectedDate.ToShortDateString()" />

    </form>

</div>

@section scripts{
    <script src="~/js/rm-boxtable.js" asp-append-version="true"></script>
    <script>
        (function () {
            function grayZeros() {
                document.querySelectorAll('.rm-scores-table td.tdr, .rm-scores-table td.rm-badge-cell, .rm-scores-table td.value-badge-cell, .rm-scores-table td.pct-badge-cell').forEach(function (c) {
                    var t = c.textContent.replace(/[,%\s]/g, '');
                    var n = parseFloat(t);
                    c.classList.toggle('rm-sc-z', t === '' || t === '-' || (!isNaN(n) && Math.abs(n) < 0.005));
                });
            }
            grayZeros();
            document.addEventListener('rm:live-updated', grayZeros);
        })();
    </script>
}
