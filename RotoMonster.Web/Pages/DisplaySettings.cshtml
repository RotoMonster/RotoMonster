@page
@model RotoMonster.Pages.DisplaySettingsModel
@{
    ViewData["Title"] = "DisplaySettings";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container rm-display">
    <form method="post">

        <div class="rm-display-bar">
            <input type="search" id="rmDisplayFilter" class="form-control" placeholder="Find a column..." autocomplete="off" />
            <span class="rm-display-count" id="rmDisplayCount"></span>
            <button type="button" class="rm-display-link" id="rmDisplayAll">Select all</button>
            <button type="button" class="rm-display-link" id="rmDisplayNone">Clear all</button>
        </div>
        <div class="mt-2 mb-2">
            <button class="btn btn-primary">Save</button>
        </div>

        <div class="row">
            <div class="col-auto m-2">
                <h4>Stat Columns</h4>
                @for (var i = 0; i < Model.DisplayCategorySelects.Count(); i++)
                {
                    <div class="ms-2">
                        <input type="checkbox" asp-for="@Model.DisplayCategorySelects[i].Selected" />
                        <label asp-for="@Model.DisplayCategorySelects[i].Selected">@Model.DisplayCategorySelects[i].Name</label>
                        <input type="hidden" asp-for="@Model.DisplayCategorySelects[i].Id" />
                        <input type="hidden" asp-for="@Model.DisplayCategorySelects[i].Name" />
                    </div>
                }
            </div>
            <div class="col-auto m-2">
                <h4>Other Columns</h4>
                @for (var i = 0; i < Model.DisplayColumnSelects.Count(); i++)
                {
                    <div class="ms-2">
                        <input type="checkbox" asp-for="@Model.DisplayColumnSelects[i].Selected" />
                        <label asp-for="@Model.DisplayColumnSelects[i].Selected">@Model.DisplayColumnSelects[i].Name</label>
                        <input type="hidden" asp-for="@Model.DisplayColumnSelects[i].Id" />
                        <input type="hidden" asp-for="@Model.DisplayColumnSelects[i].Name" />
                    </div>
                }
            </div>
        </div>
    </form>
</div>

<script>
(function () {
    var filter = document.getElementById("rmDisplayFilter");
    if (!filter) return;

    var root = document.querySelector(".rm-display");
    var rows = Array.prototype.slice.call(root.querySelectorAll(".ms-2"));
    var count = document.getElementById("rmDisplayCount");

    function visibleRows() {
        return rows.filter(function (r) { return r.style.display !== "none"; });
    }

    function updateCount() {
        var boxes = root.querySelectorAll('input[type="checkbox"]');
        var on = 0;
        Array.prototype.forEach.call(boxes, function (b) { if (b.checked) on++; });
        count.textContent = on + " of " + boxes.length + " selected";
    }

    filter.addEventListener("input", function () {
        var term = filter.value.toLowerCase().trim();
        rows.forEach(function (row) {
            var label = row.querySelector("label");
            var text = label ? label.textContent.toLowerCase() : "";
            row.style.display = (term === "" || text.indexOf(term) !== -1) ? "" : "none";
        });
    });

    function setAll(state) {
        visibleRows().forEach(function (row) {
            var box = row.querySelector('input[type="checkbox"]');
            if (box) box.checked = state;
        });
        updateCount();
    }

    document.getElementById("rmDisplayAll").addEventListener("click", function () { setAll(true); });
    document.getElementById("rmDisplayNone").addEventListener("click", function () { setAll(false); });

    root.addEventListener("change", function (e) {
        if (e.target && e.target.type === "checkbox") updateCount();
    });

    updateCount();
})();
</script>
