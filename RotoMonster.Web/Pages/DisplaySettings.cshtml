@page
@model RotoMonster.Pages.DisplaySettingsModel
@{
    ViewData["Title"] = "DisplaySettings";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container rm-display">

    @Html.Raw(new PageGuide("display-guide")
        .WithTitle("Display Settings")
        .WithPurpose("Pick your timezone and which columns show in the player tables, like on Rankings.")
        .AddSection("Timezone", "<p>Game times across the site show in the timezone you pick here. It saves as soon as you change it.</p>")
        .AddSection("Choosing columns", "<p>Check the <strong>Stat Columns</strong> and <strong>Other Columns</strong> you want to see, then click <strong>Save</strong>.</p><p>Use the search box to find a column, <strong>Use defaults</strong> to go back to the standard set, or <strong>Select all</strong> and <strong>Clear all</strong> to start fresh.</p>")
        .WithTourId("display-tour")
        .Render())

    @Html.Raw(new Tour("display-tour")
        .WithManualTrigger()
        .AddStep("rmTimezone", "Game times across the site show in this timezone. It saves as soon as you change it.", TooltipPosition.Bottom)
        .AddStep("rmDisplayFilter", "Search for a column by name.", TooltipPosition.Bottom)
        .AddStep("rmDisplayDefaults", "Go back to the standard set of columns.", TooltipPosition.Bottom)
        .AddStep("rm-tour-disp-stats", "Check the columns you want to see in the player tables.", TooltipPosition.Bottom)
        .AddStep("rm-tour-disp-save", "Save your columns when you are done.", TooltipPosition.Bottom)
        .Render())
    <form method="post" asp-page-handler="Timezone" class="rm-tz-form" id="timezone">
        <label for="rmTimezone" class="rm-tz-label">Show game times in</label>
        <select id="rmTimezone" name="tz" class="form-select rm-tz-select" onchange="this.form.requestSubmit()">
            @foreach (var region in RotoMonster.Core.Game.DisplayZones.Select(z => z.Region).Distinct())
            {
                <optgroup label="@region">
                    @foreach (var z in RotoMonster.Core.Game.DisplayZones.Where(z => z.Region == region))
                    {
                        <option value="@z.Id" selected="@(z.Id == RotoMonster.Core.Game.DisplayZoneId)">@RotoMonster.Core.Game.DisplayZoneLabel(z.Id)</option>
                    }
                </optgroup>
            }
        </select>
    </form>

    <form method="post">

        <div class="rm-display-bar">
            <input type="search" id="rmDisplayFilter" class="form-control" placeholder="Find a column..." autocomplete="off" />
            <span class="rm-display-count" id="rmDisplayCount"></span>
            <button type="button" class="rm-display-link" id="rmDisplayDefaults">Use defaults</button>
            <button type="button" class="rm-display-link" id="rmDisplayAll">Select all</button>
            <button type="button" class="rm-display-link" id="rmDisplayNone">Clear all</button>
        </div>
        <div class="mt-2 mb-2">
            <button class="btn btn-primary" id="rm-tour-disp-save">Save</button>
        </div>

        <div class="row">
            <div class="col-auto m-2">
                <h4 id="rm-tour-disp-stats">Stat Columns</h4>
                @for (var i = 0; i < Model.DisplayCategorySelects.Count(); i++)
                {
                    <div class="ms-2 @(Model.DisplayCategorySelects[i].Category.IsDefaultDisplayCategory ? "rm-default" : "")">
                        <input type="checkbox" asp-for="@Model.DisplayCategorySelects[i].Selected" />
                        <label asp-for="@Model.DisplayCategorySelects[i].Selected">@Model.DisplayCategorySelects[i].Name</label>
                        <input type="hidden" asp-for="@Model.DisplayCategorySelects[i].Id" />
                        <input type="hidden" asp-for="@Model.DisplayCategorySelects[i].Name" />
                    </div>
                }
            </div>
            <div class="col-auto m-2">
                <h4>Other Columns</h4>
                @for (var i = 0; i < Model.DisplayColumnSelects.Count(); i++)
                {
                    <div class="ms-2">
                        <input type="checkbox" asp-for="@Model.DisplayColumnSelects[i].Selected" />
                        <label asp-for="@Model.DisplayColumnSelects[i].Selected">@Model.DisplayColumnSelects[i].Name</label>
                        <input type="hidden" asp-for="@Model.DisplayColumnSelects[i].Id" />
                        <input type="hidden" asp-for="@Model.DisplayColumnSelects[i].Name" />
                    </div>
                }
            </div>
        </div>
    </form>
</div>

<script>
(function () {
    var filter = document.getElementById("rmDisplayFilter");
    if (!filter) return;

    var root = document.querySelector(".rm-display");
    var rows = Array.prototype.slice.call(root.querySelectorAll(".ms-2"));
    var count = document.getElementById("rmDisplayCount");

    function visibleRows() {
        return rows.filter(function (r) { return r.style.display !== "none"; });
    }

    function updateCount() {
        var boxes = root.querySelectorAll('input[type="checkbox"]');
        var on = 0;
        Array.prototype.forEach.call(boxes, function (b) { if (b.checked) on++; });
        count.textContent = on + " of " + boxes.length + " selected";
    }

    filter.addEventListener("input", function () {
        var term = filter.value.toLowerCase().trim();
        rows.forEach(function (row) {
            var label = row.querySelector("label");
            var text = label ? label.textContent.toLowerCase() : "";
            row.style.display = (term === "" || text.indexOf(term) !== -1) ? "" : "none";
        });
    });

    function setAll(state) {
        visibleRows().forEach(function (row) {
            var box = row.querySelector('input[type="checkbox"]');
            if (box) box.checked = state;
        });
        updateCount();
    }

    var statCol = root.querySelector(".row > .col-auto");
    var defBtn = document.getElementById("rmDisplayDefaults");
    if (defBtn) {
        defBtn.addEventListener("click", function () {
            rows.forEach(function (row) {
                if (!statCol || !statCol.contains(row)) return;
                var box = row.querySelector('input[type="checkbox"]');
                if (box) box.checked = row.classList.contains("rm-default");
            });
            updateCount();
        });
    }

    document.getElementById("rmDisplayAll").addEventListener("click", function () { setAll(true); });
    document.getElementById("rmDisplayNone").addEventListener("click", function () { setAll(false); });

    root.addEventListener("change", function (e) {
        if (e.target && e.target.type === "checkbox") updateCount();
    });

    updateCount();
})();
</script>
