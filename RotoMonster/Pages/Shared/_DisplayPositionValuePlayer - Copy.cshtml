@using RotoMonster.Core

@model PositionValuePlayer

@if (Model != null)
{
    @if (Model.IsStartable)
    {
        <span class="small" data-toggle="tooltip" data-placement="top" title="Top Player at @Model.MostValuableActiveRosterSpot.Title">
            @Html.Raw(new Icon(new IconInput { Type = IconType.Success, Size = 16 }).Render())
        </span>
    }
    <small>@Model.MostValuableActiveRosterSpot.Title</small>
    @String.Format("{0:#####0.00}",Model.PositionValue)
}
