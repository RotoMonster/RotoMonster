@model RotoMonster.Core.DisplayPlayerGameState
@if (Model.PlayerGameState != null)
{
    <span class="me-1 badge"
          data-bs-toggle="tooltip"
          data-bs-placement="top"
          title="@Model.PlayerGameState.PlayerGameStateType.Title"
          style="color:white;background-color:#@Model.PlayerGameState.PlayerGameStateType.TextColor">
        <i class="@Model.PlayerGameState.PlayerGameStateType.Icon"></i>
        @if (Model.PlayerGameState.Details != null && Model.PlayerGameState.Details.Length > 0)
        {
            <span>@Model.PlayerGameState.Details</span>
        }
        @if (Model.PlayerGameState.PlayerGameStateType.ShowLockAfterStart & Model.PlayerGameState.Game.HasStarted)
        {
            @Html.Raw(new Icon(new IconInput { Type = IconType.Lock, Size = 16 }).Render())
        }
    </span>
}
