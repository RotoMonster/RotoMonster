@model RotoMonster.Core.DisplayMonsterBarPlayer

@if (Model != null && Model.MonsterBarPlayer != null)
{
    if (!Model.IsCompact)
    {
        string mbarCss = "mbar-" + Model.MonsterBarItems.Count.ToString();
        <div class="@mbarCss">
            @for (int i = 0; i < Model.MonsterBarItems.Count; i++)
            {
                RotoMonster.Core.MonsterBarItem item = Model.MonsterBarItems[i];
                RotoMonster.Core.MonsterBarValuePlayer monsterBarValuePlayer = Model.MonsterBarPlayer.MonsterBarValuePlayers[i];

                if (monsterBarValuePlayer != null)
                {
                    <span class="mbarp tdc" style="background-color:#@monsterBarValuePlayer.ValuePlayer.LeagueValueColor;">
                        @if (item.Title != "D")
                        {
                            string topCss = monsterBarValuePlayer.IsTopPlayer ? "istop" : (monsterBarValuePlayer.IsOwnablePlayer ? "isown" : "dim");
                            <span class="mbar-text @topCss small">
                                @monsterBarValuePlayer.ValuePlayer.StatPlayer.Games
                                @if (monsterBarValuePlayer.ValuePlayer.StatPlayer.MeasureText.Length > 0)
                                {
                                    <span class="measure-text">
                                        @monsterBarValuePlayer.ValuePlayer.StatPlayer.MeasureText
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <small class="mbar-text">@item.Title</small>
                        }
                    </span>
                }
                else
                {
                    <span class="mbarp mbarp-z">&nbsp;</span>
                }
            }
        </div>
    }
    else
    {
        string mbarCss = "mbarc-" + Model.MonsterBarItems.Count.ToString();
        <div class="@mbarCss">
            @for (int i = 0; i < Model.MonsterBarItems.Count; i++)
            {
                RotoMonster.Core.MonsterBarItem item = Model.MonsterBarItems[i];
                RotoMonster.Core.MonsterBarValuePlayer monsterBarValuePlayer = Model.MonsterBarPlayer.MonsterBarValuePlayers[i];

                if (monsterBarValuePlayer != null && monsterBarValuePlayer.ValuePlayer != null)
                {
                    string topCss = monsterBarValuePlayer.IsTopPlayer ? "istop" : (monsterBarValuePlayer.IsOwnablePlayer ? "isown" : "dim");

                    <span class="mbarpc @topCss" style="background-color:#@monsterBarValuePlayer.ValuePlayer.LeagueValueColor;">
                        <small>@monsterBarValuePlayer.ValuePlayer.StatPlayer.Games</small>
                    </span>
                }
                else
                {
                    <span class="mbarpc mbarp-z">&nbsp;</span>
                }
            }
        </div>
    }
}
