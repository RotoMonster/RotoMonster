@model RotoMonster.Core.DisplayPlayer

@if (Model.UserLeagueTeam != null)
{
    @if (Model.IsActive)
    {
    }
    else if (Model.IsIR)
    {
        <span class="ml-1"
              data-toggle="tooltip"
              data-placement="top"
              title="Injured Reserve">IR</span>
    }
    else
    {
        <span class=" ml-1"
              data-toggle="tooltip"
              data-placement="top"
              title="Bench">BN</span>
    }

    @if (Model.IsMyLastPlayer)
    {
        <span class="ml-1"
              data-toggle="tooltip"
              data-placement="top"
              title="Your last owned player">@Html.Raw(new Icon(new IconInput { Type = IconType.ArrowDown, Size = 16 }).Render())</span>
    }
}

else if (Model.IsWaiver)
{
    <span class="text-black"
          data-toggle="tooltip"
          data-placement="top"
          title="On Waiver Wire" style="color:black;">WW</span>
}
