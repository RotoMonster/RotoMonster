@page
@model RotoMonster.ListModel
@{
    ViewData["Title"] = "Players";
}

<h1>Player Search</h1>

<form method="get">
    <div class="form-group">
        <div class="input-group">
            <input type="search" id="tags" class="form-control" asp-for="SearchTerm" />
            <button class="btn btn-primary ml-1">Search</button>
        </div>
    </div>
</form>

@foreach (var player in Model.Players)
{
    <partial name="_Summary" model="player" />
}

<div class="mt-3">
    <a asp-page="./Edit" class="btn btn-success">Add New</a>
</div>

@section footer{
}

@section scripts{
    <partial name="_PlayerSearchScripts" model='"tags"' />
}