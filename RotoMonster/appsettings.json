{
  "Sport": "MLB",
  "AdminOnly": "1",
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "EmailSender": {
    "From": "support@rotomonster.com",
    "Host": "email-smtp.us-west-2.amazonaws.com",
    "Port": 587,
    "EnableSSL": true,
    "UserName": "CHANGEME",
    "Password": "CHANGEME"
  },
  "AllowedHosts": "*",
  "Message": "AppMessage",
  "InstanceID": "i1",
  "UseDebugFiles": "1",
  "RootPath": "/",
  "DebugPath": "C:\\rm_debug\\{sport}\\{filetype}_{userid}_{league}.{extension}",
  "YahooClientId": "CHANGEME",
  "YahooClientSecret": "CHANGEME",
  "ConnectionStrings": {
    "RotoMonsterDb": "Data Source=.; Initial Catalog=RM_{sport}; User Id=sa;password=CHANGEME;TrustServerCertificate=true;",
    "RotoMonsterSharedDb": "Data Source=.; Initial Catalog=RM_Shared; User Id=sa;password=CHANGEME;TrustServerCertificate=true;"
  },
  "Serilog": {
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Data Source=.; Initial Catalog=RM_NBA; User Id=sa;password=CHANGEME;TrustServerCertificate=true;",
          "tableName": "_Logs",
          "autoCreateSqlTable": true,
          //"outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] [{EventId}] {Message}{NewLine}{Exception}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
